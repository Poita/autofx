// Generated by: autofx 'bubbling poison cloud' -d 1.5 -f 45 --loop -s -o examples/gallery-opus-5-5/poison.gif
// Render with:  autofx examples/gallery-opus-5-5/poison.glsl -d 1.5 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5/poison.gif

#define TAU 6.28318530718
#define DUR 1.5

float hash(vec3 p){ p=fract(p*0.3183099+.1); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }
float noise(vec3 x){
    vec3 i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f);
    return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),
               mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);
}
// Time is a phase angle 'a'; noise is sampled along a circle so every octave loops.
float fbm(vec2 p, float a){
    float s=0.0, amp=0.5;
    for(int i=0;i<6;i++){
        float fi=float(i);
        float r=0.3+0.12*fi;
        vec3 q=vec3(p, fi*3.7)+vec3(cos(a+fi)*r, sin(a+fi)*r, cos(a+fi*1.3)*r);
        s+=amp*noise(q);
        p=mat2(1.6,1.2,-1.2,1.6)*p; amp*=0.5;
    }
    return s;
}
float smin(float a,float b,float k){ float h=clamp(0.5+0.5*(b-a)/k,0.0,1.0); return mix(b,a,h)-k*h*(1.0-h); }

// Signed distance of a lumpy cloud built from pulsing lobes.
float lobes(vec2 p, float a){
    float d=length(p-vec2(0.0,-0.02))-0.20-0.01*sin(a);
    for(int i=0;i<9;i++){
        float fi=float(i);
        float ang=fi/9.0*TAU+0.3;
        float rad=0.17+0.03*fract(sin(fi*12.7)*437.5);
        vec2 c=vec2(cos(ang),sin(ang)*0.85)*rad+vec2(0.0,-0.02);
        float r=0.085+0.03*fract(sin(fi*7.1)*913.3)+0.015*sin(a*(1.0+mod(fi,2.0))+fi*1.7);
        d=smin(d,length(p-c)-r,0.06);
    }
    return d;
}

float density(vec2 p, float a){
    vec2 w=vec2(fbm(p*3.0+3.1,a), fbm(p*3.0+7.7,a+1.0));
    float n=fbm(p*4.0+w*1.5,a);
    float d=lobes(p,a);
    return -d*7.0 + (n-0.5)*0.9;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float a=TAU*fract(iTime/DUR);

    float dn=density(p,a);
    float alpha=smoothstep(0.0,0.18,dn);
    float e=0.012;
    float dl=density(p+vec2(-e,e),a);
    float light=clamp((dn-dl)*5.0+0.5,0.0,1.0);

    float inner=smoothstep(0.0,1.2,dn);
    vec3 deep=vec3(0.05,0.16,0.04);
    vec3 mid=vec3(0.30,0.70,0.10);
    vec3 hi=vec3(0.85,1.0,0.45);
    vec3 col=mix(mid,deep,inner*0.75);
    col=mix(col,hi,pow(light,1.5)*0.85);
    col*=mix(0.6,1.0,light);
    // purple toxic fringe
    col=mix(col,vec3(0.42,0.14,0.52),smoothstep(0.3,0.0,dn)*0.55);
    // inner glowing swirl
    float sw=fbm(p*6.0-2.0,a+2.0);
    col+=vec3(0.35,0.85,0.1)*smoothstep(0.55,0.75,sw)*inner*0.8;

    vec4 bub=vec4(0.0);
    for(int i=0;i<20;i++){
        float fi=float(i);
        float h1=fract(sin(fi*91.7+iSeed*13.1)*4375.5);
        float h2=fract(sin(fi*37.3+iSeed*7.3)*2317.1);
        float h3=fract(sin(fi*13.9)*9127.3);
        float k=floor(1.0+h3*2.0); // integer cycles per loop
        float ph=fract(iTime/DUR*k+h1);
        float x0=(h2-0.5)*0.38;
        float top=0.22-x0*x0*2.5;
        vec2 c=vec2(x0, mix(-0.20,top,ph));
        c.x+=0.015*sin(ph*TAU*2.0+fi);
        float R=(0.012+0.026*(1.0-h3*0.6)*fract(h1*7.3+0.3))*smoothstep(0.0,0.6,ph)+0.003;
        float d=length(p-c);
        if(ph<0.88){
            float ring=smoothstep(R,R-0.004,d)*smoothstep(R-0.012,R-0.004,d);
            float fill=smoothstep(R,R-0.003,d);
            vec2 hp=c+vec2(-0.4,0.4)*R;
            float spec=smoothstep(R*0.3,0.0,length(p-hp));
            vec3 bc=mix(vec3(0.35,0.85,0.2),vec3(0.85,1.0,0.55),ring);
            bc=mix(bc,vec3(1.0),spec);
            float ba=max(fill*0.55,max(ring,spec));
            bub.rgb=mix(bub.rgb,bc,ba);
            bub.a=max(bub.a,ba);
        } else {
            // pop: splash droplets flying outward
            float pt=(ph-0.88)/0.12;
            float rr=R*(1.0+pt*1.2);
            float ang=atan(p.y-c.y,p.x-c.x);
            float drops=smoothstep(0.6,1.0,sin(ang*7.0+fi*3.0))*smoothstep(0.006,0.0,abs(d-rr))*(1.0-pt);
            bub.rgb=mix(bub.rgb,vec3(0.85,1.0,0.55),drops);
            bub.a=max(bub.a,drops);
        }
    }

    col=mix(col,bub.rgb,bub.a);
    alpha=max(alpha,bub.a);
    fragColor=vec4(col,alpha);
}

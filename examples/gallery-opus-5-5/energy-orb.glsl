// Generated by: autofx 'glowing cyan energy orb' -d 1.5 -f 45 --loop -s -o examples/gallery-opus-5-5/energy-orb.gif
// Render with:  autofx examples/gallery-opus-5-5/energy-orb.glsl -d 1.5 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5/energy-orb.gif

#define TAU 6.28318530718
#define DUR 1.5

float hsh(vec3 p){ p = fract(p*0.3183099+0.1); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }
float vnoise(vec3 x){
    vec3 i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f);
    return mix(mix(mix(hsh(i),hsh(i+vec3(1,0,0)),f.x),mix(hsh(i+vec3(0,1,0)),hsh(i+vec3(1,1,0)),f.x),f.y),
               mix(mix(hsh(i+vec3(0,0,1)),hsh(i+vec3(1,0,1)),f.x),mix(hsh(i+vec3(0,1,1)),hsh(i+vec3(1,1,1)),f.x),f.y),f.z);
}
// FBM whose time dimension travels a closed circle, so it loops exactly.
float fbmLoop(vec2 p, float ph, float rad){
    float v=0.0, a=0.5;
    vec3 q = vec3(p, 0.0) + vec3(0.0, cos(ph)*rad, sin(ph)*rad) + iSeed*3.7;
    for(int i=0;i<6;i++){ v+=a*vnoise(q); q=q*2.03+vec3(1.7,9.2,3.1); a*=0.5; }
    return v;
}
mat2 rot(float a){ float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/(0.5*iResolution.y);
    float ph = TAU*fract(iTime/DUR);
    float r = length(p);
    float pulse = 0.5+0.5*sin(ph);

    float R = 0.36 + 0.015*sin(ph);
    vec3 col = vec3(0.0);
    float alpha = 0.0;

    if(r < R){
        float z = sqrt(R*R - r*r)/R;
        vec2 sp = p/R / (0.6+0.4*z);
        vec2 s1 = rot(ph)*sp;
        vec2 s2 = rot(-ph*2.0)*sp;
        float n1 = fbmLoop(s1*2.2, ph, 1.2);
        float n2 = fbmLoop(s2*3.0 + n1*1.5, ph, 0.9);
        float veins = pow(1.0 - abs(n2*2.0-1.0), 6.0);
        float core = exp(-r*r/(R*R)*3.5);
        vec3 deep = vec3(0.0,0.25,0.45);
        vec3 cyan = vec3(0.1,0.85,1.0);
        vec3 inner = mix(deep, cyan, 0.4+0.6*n1);
        inner += vec3(0.6,1.0,1.0)*veins*1.3;
        inner += vec3(0.85,1.0,1.0)*core*(1.2+0.4*pulse);
        float fres = pow(1.0-z, 2.5);
        inner += cyan*fres*1.5;
        float edge = smoothstep(R, R-0.01, r);
        col += inner*edge;
        alpha = max(alpha, edge);
    }

    // Outer glow and corona, bounded to r < 0.92
    float bound = pow(max(0.0, 1.0 - r/0.92), 2.0);
    float d = max(r - R, 0.0);
    float ang = atan(p.y, p.x);
    vec2 cp = vec2(cos(ang), sin(ang));
    float flick = fbmLoop(cp*2.5 + vec2(d*4.0), ph, 1.0);
    float tendril = fbmLoop(rot(ph)*cp*3.0 + vec2(0.0, d*6.0), ph, 0.7);
    float corona = exp(-d*(9.0 - 4.0*flick)) * (0.6+0.8*tendril);
    float glow = (0.035/(d+0.05)) * (0.8+0.25*pulse);
    float g = (corona*0.9 + glow*0.6) * bound;
    vec3 gcol = mix(vec3(0.0,0.45,1.0), vec3(0.2,1.0,1.0), clamp(corona,0.0,1.0));
    float outside = smoothstep(R-0.01, R, r);
    col += gcol*g*outside;
    alpha = max(alpha, clamp(g*outside*1.4, 0.0, 1.0));

    // Orbiting sparks
    for(int i=0;i<10;i++){
        float fi=float(i);
        float h = hsh(vec3(fi, iSeed, 3.1));
        float a0 = h*TAU + ph*(mod(fi,2.0)<0.5?1.0:-1.0)*(1.0+floor(h*2.0));
        float orr = R + 0.08 + 0.12*hsh(vec3(fi,7.0,iSeed)) + 0.03*sin(ph+fi);
        vec2 sp = vec2(cos(a0), sin(a0)*0.6)*orr;
        sp = rot(fi*0.7)*sp;
        float sd = length(p - sp);
        float s = 0.00025/(sd*sd+0.00025) * (0.6+0.4*sin(ph*2.0+fi*1.3));
        col += vec3(0.6,1.0,1.0)*s*1.5;
        alpha = max(alpha, clamp(s*1.5,0.0,1.0));
    }

    col = 1.0 - exp(-col*1.3);
    fragColor = vec4(col, clamp(alpha, 0.0, 1.0));
}

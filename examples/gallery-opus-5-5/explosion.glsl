// Generated by: autofx 'fiery explosion' -f 30 -s -o examples/gallery-opus-5-5/explosion.gif
// Render with:  autofx examples/gallery-opus-5-5/explosion.glsl -d 1.0 -r 256x256 -f 30 -s -o examples/gallery-opus-5-5/explosion.gif

float hash11(float n){return fract(sin(n)*43758.5453);}
float vnoise(vec3 x){
    vec3 i=floor(x),f=fract(x);f=f*f*(3.0-2.0*f);
    float n=i.x+i.y*157.0+113.0*i.z;
    return mix(mix(mix(hash11(n),hash11(n+1.0),f.x),mix(hash11(n+157.0),hash11(n+158.0),f.x),f.y),
               mix(mix(hash11(n+113.0),hash11(n+114.0),f.x),mix(hash11(n+270.0),hash11(n+271.0),f.x),f.y),f.z);
}
float fbm(vec3 p){
    float a=0.5,s=0.0;
    for(int i=0;i<6;i++){s+=a*vnoise(p);p=p*2.03+vec3(1.7,9.2,3.1);a*=0.5;}
    return s;
}
vec3 fireRamp(float x){
    x=clamp(x,0.0,1.0);
    vec3 c=mix(vec3(0.15,0.02,0.0),vec3(0.6,0.06,0.0),smoothstep(0.0,0.25,x));
    c=mix(c,vec3(1.0,0.35,0.02),smoothstep(0.2,0.5,x));
    c=mix(c,vec3(1.0,0.75,0.2),smoothstep(0.45,0.75,x));
    c=mix(c,vec3(1.0,0.97,0.85),smoothstep(0.75,1.0,x));
    return c;
}
void mainImage(out vec4 fragColor,in vec2 fragCoord){
    vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float t=clamp(iTime,0.0,1.0);
    float seed=iSeed*17.31;
    float r=length(p);

    float R=0.28*(1.0-exp(-7.0*t))+0.02;
    float life=1.0-smoothstep(0.6,1.0,t);
    float heat=exp(-2.6*t);

    vec3 q=vec3(p*5.0,t*1.5+seed);
    vec3 warp=vec3(fbm(q),fbm(q+vec3(5.2,1.3,2.8)),0.0);
    float n=fbm(q*1.3+2.5*warp+vec3(0.0,-t*2.0,0.0));
    float n2=fbm(vec3(p*11.0,t*2.0+seed+7.0));

    // Turbulent fireball body that erodes into wisps as it cools
    float shell=r/R+(n-0.5)*0.9+(n2-0.5)*0.35;
    float body=1.0-smoothstep(0.55,1.0,shell);
    float erosion=smoothstep(0.25,0.95,t);
    body*=smoothstep(erosion*0.9-0.1,erosion*0.9+0.25,n*1.1+n2*0.3);

    float core=1.0-smoothstep(0.0,0.8,shell);
    float temp=body*(0.35+0.75*core)*heat*1.3+body*0.15;
    temp*=mix(0.45,1.5,smoothstep(0.3,0.75,n2*0.6+n*0.6));

    float fireA=smoothstep(0.02,0.22,temp);
    vec3 fireCol=fireRamp(temp);

    // Dark smoke billows around the fire, rising slightly and thinning out
    vec2 ps=p-vec2(0.0,0.04*t);
    float rs=length(ps);
    float smokeShell=rs/(R*1.2)+(n-0.5)*1.1;
    float smoke=(1.0-smoothstep(0.5,1.0,smokeShell))*smoothstep(0.05,0.3,t);
    smoke*=smoothstep(0.1+0.5*erosion,0.45+0.5*erosion,n+n2*0.3);
    vec3 smokeCol=vec3(0.18,0.13,0.10)*(0.5+0.9*n2);
    float smokeA=clamp(smoke,0.0,1.0)*0.92;

    vec3 col=mix(smokeCol,fireCol,fireA);
    float a=fireA+smokeA*(1.0-fireA);

    // Additive emissive elements: flash, shockwave, sparks
    vec3 em=vec3(0.0);
    float emA=0.0;
    float flash=exp(-t*22.0)*exp(-r*r/(0.02+0.25*t));
    em+=vec3(1.0,0.9,0.7)*flash*1.5;
    emA=max(emA,flash*1.5);

    float sr=0.42*(1.0-exp(-9.0*t));
    float ring=exp(-pow((r-sr)/0.012,2.0))*exp(-t*10.0)*(0.5+0.5*n2)*step(0.005,t);
    em+=vec3(1.0,0.6,0.25)*ring;
    emA=max(emA,ring*0.8);

    for(int i=0;i<60;i++){
        float fi=float(i);
        float h1=hash11(fi*1.31+seed),h2=hash11(fi*7.77+seed+3.0),h3=hash11(fi*3.19+seed+9.0);
        float th=h1*6.2832;
        float dist=(0.22+0.2*h2)*(1.0-exp(-5.0*t));
        vec2 vel=vec2(cos(th),sin(th));
        vec2 sp=vel*dist;
        sp.y-=0.08*t*t*h3;
        float sl=1.0-smoothstep(0.3+0.3*h3,0.55+0.3*h3,t);
        vec2 d=p-sp;
        float along=dot(d,vel);
        float perp=length(d-vel*along);
        float tail=0.04*exp(-4.0*t);
        float streak=exp(-perp*perp/0.000012)*smoothstep(-tail-0.004,0.0,along)*(1.0-smoothstep(0.0,0.004,along));
        float glow=exp(-dot(d,d)/0.00004);
        float s=(streak+glow)*sl*step(0.01,t);
        em+=mix(vec3(1.0,0.4,0.05),vec3(1.0,0.9,0.6),h2)*s*1.5;
        emA=max(emA,s);
    }
    emA=clamp(emA,0.0,1.0);

    // Composite emissive over body in straight-alpha form
    float outA=emA+a*(1.0-emA);
    vec3 outC=(em+col*a*(1.0-emA))/max(outA,1e-4);
    outC=clamp(outC,0.0,1.0);

    outA*=life;
    if(t>=1.0) outA=0.0;
    fragColor=vec4(outC,clamp(outA,0.0,1.0));
}
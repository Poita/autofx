#define PI 3.14159265
#define NRINGS 5
#define MAXR 0.40

// Water height at radius r: a sum of expanding wave packets that fade in and out, spaced evenly in phase.
float height(float r, float t) {
    float h = 0.0;
    for (int i = 0; i < NRINGS; i++) {
        float p = fract(t / 2.0 + float(i) / float(NRINGS));
        float R = 0.02 + MAXR * sqrt(p);
        float amp = pow(sin(PI * p), 1.5) * (1.0 - 0.4 * p);
        float w = 0.018 + 0.014 * p;
        float x = r - R;
        h += amp * exp(-x * x / (w * w)) * cos(x * 140.0 / (1.0 + 0.6 * p));
    }
    return h;
}


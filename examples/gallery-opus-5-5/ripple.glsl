    float r = length(uv);
    float t = iTime;
    float e = 0.0015;
    float h = height(r, t);
    float dh = (height(r + e, t) - height(r - e, t)) / (2.0 * e);
    vec2 dir = r > 1e-5 ? uv / r : vec2(0.0);
    vec3 n = normalize(vec3(-dir * dh * 0.012, 1.0));
    vec3 L = normalize(vec3(-0.5, 0.6, 0.8));
    vec3 V = vec3(0.0, 0.0, 1.0);
    float diff = clamp(dot(n, L), 0.0, 1.0);
    float spec = pow(clamp(dot(reflect(-L, n), V), 0.0, 1.0), 60.0);
    float slope = length(n.xy);
    float intensity = abs(h) * 0.8 + slope * 0.9;

    vec3 deep = vec3(0.03, 0.22, 0.45);
    vec3 shallow = vec3(0.40, 0.85, 1.0);
    vec3 col = mix(deep, shallow, clamp(0.5 + 0.7 * h, 0.0, 1.0));
    col *= 0.5 + 0.7 * diff;
    col += vec3(0.9, 0.97, 1.0) * spec * 1.5;

    float alpha = smoothstep(0.06, 0.7, intensity) + spec;
    alpha = clamp(alpha, 0.0, 1.0);
    fragColor = vec4(col * alpha, alpha);
}
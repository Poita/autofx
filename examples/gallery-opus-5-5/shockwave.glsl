float hash(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){
    vec2 i = floor(p), f = fract(p);
    vec2 u = f*f*(3.0-2.0*f);
    return mix(mix(hash(i), hash(i+vec2(1,0)), u.x), mix(hash(i+vec2(0,1)), hash(i+vec2(1,1)), u.x), u.y);
}
float fbm(vec2 p){
    float v = 0.0, a = 0.5;
    for (int i = 0; i < 5; i++){ v += a*noise(p); p = p*2.03 + 17.1; a *= 0.5; }
    return v;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 p = (fragCoord - 0.5*iResolution.xy) / iResolution.y;
    float T = 0.6;
    float t = clamp(iTime / T, 0.0, 1.0);

    float r = length(p);
    float ang = atan(p.y, p.x);
    vec2 dir = vec2(cos(ang), sin(ang));

    float prog = 1.0 - pow(1.0 - t, 3.0);
    float R = mix(0.02, 0.37, prog);

    float seed = iSeed * 13.7;
    float n = fbm(dir*3.0 + seed + t*2.0);
    float Rw = R + (n - 0.5) * 0.03 * prog;

    float width = mix(0.045, 0.010, prog);
    float d = r - Rw;

    float front = exp(-pow(max(d, 0.0) / (width*0.5), 2.0));
    float back  = exp(-pow(min(d, 0.0) / (width*1.6), 2.0));
    float ring = (d > 0.0) ? front : back;

    float streak = fbm(vec2(ang*6.0 + seed, r*18.0 - t*10.0));
    float wake = smoothstep(0.0, -0.12*prog - 0.01, d) * (d < 0.0 ? 1.0 : 0.0);
    wake *= exp(d / (0.06 + 0.06*prog)) * (0.25 + 0.75*streak) * 0.45;

    float glow = exp(-pow(d / (width*3.5), 2.0)) * 0.35;

    float flash = exp(-r*r / (0.006 + 0.03*t)) * exp(-t*9.0) * 1.4;

    float env = smoothstep(0.0, 0.06, t) * (1.0 - smoothstep(0.35, 0.95, t));
    float flashEnv = smoothstep(0.0, 0.03, t) * (1.0 - smoothstep(0.3, 0.6, t));

    float ringI = (ring * (0.8 + 0.4*n) + glow + wake) * env;
    float I = ringI + flash * flashEnv;

    vec3 hot = vec3(1.0, 0.98, 0.92);
    vec3 mid = vec3(0.45, 0.8, 1.0);
    vec3 cool = vec3(0.15, 0.3, 0.9);
    vec3 col = mix(cool, mid, smoothstep(0.0, 0.5, I));
    col = mix(col, hot, smoothstep(0.5, 1.1, I));
    col += vec3(-0.1, 0.05, 0.25) * front * env * 0.5;

    float a = clamp(I, 0.0, 1.0);
    fragColor = vec4(col * a, a);
}
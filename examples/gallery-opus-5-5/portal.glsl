// Generated by: autofx 'swirling purple magic portal' -d 2.0 -f 60 --loop -s -o examples/gallery-opus-5-5/portal.gif
// Render with:  autofx examples/gallery-opus-5-5/portal.glsl -d 2.0 -r 256x256 -f 60 --loop -s -o examples/gallery-opus-5-5/portal.gif

#define TAU 6.28318530718

float hash(vec3 p){ p = fract(p*0.3183099+0.1); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }
float noise(vec3 x){
    vec3 i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f);
    return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),
               mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);
}
float fbm(vec3 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p=p*2.03+vec3(1.7,9.2,3.1); a*=0.5;} return v; }

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float ang = fract(iTime/2.0)*TAU;          // one full cycle per loop
    vec2 tc = vec2(cos(ang), sin(ang));        // loop-periodic noise offset
    float r = length(uv);
    float a = atan(uv.y, uv.x);
    float R = 0.32;
    float rr = r/R;

    // spiral coordinate: twist grows toward center, rotates one turn per loop
    float sw = a + 2.4/(r+0.10) - ang;
    vec2 dir = vec2(cos(sw), sin(sw));
    float n  = fbm(vec3(dir*(1.0+rr*1.8), rr*2.5) + vec3(tc*0.5, 0.0) + iSeed);
    float n2 = fbm(vec3(dir*(2.0+rr*2.0), rr*4.0) + vec3(tc*0.7, 1.3) + 7.0 + iSeed);

    // edge noise sampled on the unit circle so it has no angular seam
    vec2 ea = vec2(cos(a - ang), sin(a - ang));
    float en = fbm(vec3(ea*2.2, 0.0) + vec3(tc*0.4, 3.0) + iSeed);

    float arms = 0.5+0.5*sin(sw*3.0 + n*5.0);
    arms = smoothstep(0.2, 1.0, arms);

    float edgeR = R*(1.0 + 0.12*(en-0.5));
    float d = r - edgeR;
    float disc = 1.0 - smoothstep(-0.015, 0.008, d);

    float rim = exp(-abs(d)*70.0) * (0.6+0.8*n2);
    float glow = exp(-max(d,0.0)*18.0) * (0.35+0.45*n) * step(0.0, d);

    float depth = smoothstep(0.05, 1.0, rr);
    float inten = (0.15 + 1.3*arms*n + 0.5*n2*n2) * mix(0.35, 1.0, depth);
    float core = exp(-r*r*150.0);

    vec3 deep   = vec3(0.05,0.0,0.14);
    vec3 purple = vec3(0.52,0.10,0.95);
    vec3 pink   = vec3(1.0,0.55,1.0);
    vec3 col = mix(deep, purple, clamp(inten,0.0,1.0));
    col = mix(col, pink, clamp((inten-0.85)*1.5,0.0,1.0));
    col += vec3(0.85,0.65,1.0)*core*0.9;

    // sparkles orbiting the rim, integer angular speeds keep the loop seamless
    float spark = 0.0;
    for(int i=0;i<28;i++){
        float fi=float(i);
        float h1=hash(vec3(fi,1.3,iSeed)), h2=hash(vec3(fi,7.1,iSeed)), h3=hash(vec3(fi,3.7,iSeed));
        float k = 1.0 + floor(h3*2.0);
        float pa = h1*TAU - ang*k;
        float pr = R*(1.0 + 0.16*h2) + 0.012*sin(ang*k*2.0+fi);
        vec2 sp = pr*vec2(cos(pa), sin(pa));
        float tw = 0.3+0.7*pow(0.5+0.5*sin(ang*3.0+fi*2.3), 2.0);
        spark += tw*0.000025/(dot(uv-sp,uv-sp)+0.00002);
    }

    vec3 rimCol = mix(purple, vec3(1.0,0.8,1.0), 0.55);
    vec3 glowCol = vec3(0.6,0.15,1.0);
    vec3 sparkCol = vec3(1.0,0.85,1.0);
    vec3 total = col*disc + rimCol*rim*1.5 + glowCol*glow + sparkCol*spark;
    float w = disc + rim + glow + spark;
    float alpha = clamp(w, 0.0, 1.0) * smoothstep(0.49, 0.43, r);
    vec3 c = total / max(w, 1e-4) * (0.6 + 0.4*clamp(w,0.0,1.6));
    fragColor = vec4(clamp(c,0.0,1.0), alpha);
}

// Generated by: autofx 'falling meteor' -d 0.8 -f 30 -s -o examples/gallery-opus-5-5/meteor.gif
// Render with:  autofx examples/gallery-opus-5-5/meteor.glsl -d 0.8 -r 256x256 -f 30 -s -o examples/gallery-opus-5-5/meteor.gif

float hash(float n){return fract(sin(n*127.1+iSeed*13.7)*43758.5453);}
float hash2(vec2 p){return fract(sin(dot(p,vec2(127.1,311.7))+iSeed)*43758.5453);}
float noise(vec2 p){vec2 i=floor(p),f=fract(p);f=f*f*(3.-2.*f);
 return mix(mix(hash2(i),hash2(i+vec2(1,0)),f.x),mix(hash2(i+vec2(0,1)),hash2(i+vec2(1,1)),f.x),f.y);}
float fbm(vec2 p){float v=0.,a=.5;for(int i=0;i<5;i++){v+=a*noise(p);p*=2.03;a*=.5;}return v;}

vec3 fireCol(float x){
 x=clamp(x,0.,1.5);
 vec3 c=mix(vec3(0.5,0.05,0.0),vec3(1.0,0.45,0.05),smoothstep(0.,.4,x));
 c=mix(c,vec3(1.0,0.85,0.4),smoothstep(.4,.8,x));
 c=mix(c,vec3(1.0,1.0,0.95),smoothstep(.8,1.2,x));
 return c;
}

void mainImage(out vec4 fragColor,in vec2 fragCoord){
 vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y*2.0;
 float t=iTime/0.8;
 vec2 A=vec2(-0.62,0.62), B=vec2(0.5,-0.5);
 vec2 d=normalize(B-A);
 vec2 n=vec2(-d.y,d.x);
 float L=length(B-A);
 float s=clamp(t/0.72,0.,1.);
 float prog=s*(0.4+0.6*s);
 vec2 head=A+d*L*prog;
 // head appears quickly and burns out before the end
 float headI=smoothstep(0.0,0.06,t)*(1.0-smoothstep(0.5,0.72,t));
 float headR=0.05*(1.0-0.6*smoothstep(0.45,0.72,t));
 vec3 col=vec3(0); float alpha=0.;

 vec2 rel=p-head;
 float along=dot(rel,-d);
 float perp=dot(rel,n);
 float trailLen=min(0.8,L*prog);
 float trailI=smoothstep(0.0,0.08,t)*(1.0-smoothstep(0.5,0.96,t));
 if(along>0.0 && along<trailLen){
   float u=along/max(trailLen,1e-3);
   float w=headR*(1.0-0.7*u)+0.004;
   float nz=fbm(vec2(along*9.0-iTime*30.0,perp*25.0));
   float nz2=fbm(vec2(along*4.0-iTime*18.0,perp*10.0+3.0));
   float pp=perp-(nz2-0.5)*0.035*u;
   float core=exp(-pp*pp/(w*w*0.3))*(1.0-smoothstep(0.0,0.9,u));
   float glow=exp(-pp*pp/(w*w*2.5))*pow(1.0-u,1.8)*0.6;
   float smoke=exp(-pp*pp/(w*w*6.0))*(1.0-u)*smoothstep(0.0,0.25,u)*nz*0.45;
   float tr=(core*(0.6+0.8*nz)+glow*(0.4+nz)+smoke)*trailI;
   col+=fireCol(tr*1.3)*tr; alpha+=tr;
 }
 float hd=length(rel);
 float hcore=exp(-hd*hd/(headR*headR*0.25));
 float hglow=exp(-hd*hd/(headR*headR*2.0))*0.7+exp(-hd/(headR*0.9))*0.25;
 float h=(hcore*1.6+hglow)*headI;
 col+=fireCol(0.9+hcore*0.6)*h; alpha+=h;

 // sparks shed from the head, drifting back and falling
 for(int i=0;i<50;i++){
   float fi=float(i);
   float birth=hash(fi)*0.68;
   float age=(t-birth)/0.28;
   if(age<0.0||age>1.0) continue;
   float bs=clamp(birth/0.72,0.,1.);
   vec2 bp=A+d*L*bs*(0.4+0.6*bs);
   float ang=(hash(fi+7.3)-0.5)*2.0;
   vec2 dir=normalize(-d*0.5+n*ang);
   float spd=0.15+0.25*hash(fi+3.1);
   vec2 sp=bp+dir*spd*sqrt(age)*0.6+vec2(0,-0.12)*age*age;
   float life=1.0-age;
   float r=0.009*(0.6+hash(fi+9.));
   float sd=length(p-sp);
   float sv=(exp(-sd*sd/(r*r))*1.5+exp(-sd*sd/(r*r*6.0))*0.3)*life*life;
   col+=fireCol(0.5+life*0.8)*sv; alpha+=sv;
 }
 alpha=clamp(alpha,0.,1.);
 col=col/(1.0+col*0.15);
 fragColor=vec4(clamp(col,0.,1.),alpha);
}
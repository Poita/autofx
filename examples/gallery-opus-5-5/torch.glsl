// Generated by: autofx 'torch flame' -f 30 --loop -s -o examples/gallery-opus-5-5/torch.gif
// Render with:  autofx examples/gallery-opus-5-5/torch.glsl -d 1.0 -r 256x256 -f 30 --loop -s -o examples/gallery-opus-5-5/torch.gif

#define TAU 6.28318530718

float hash(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){
    vec2 i=floor(p), f=fract(p);
    vec2 u=f*f*(3.0-2.0*f);
    return mix(mix(hash(i),hash(i+vec2(1,0)),u.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),u.x), u.y);
}
float fbm(vec2 p){
    float v=0.0, a=0.5;
    mat2 r=mat2(0.8,0.6,-0.6,0.8);
    for(int i=0;i<6;i++){ v+=a*noise(p); p=r*p*2.03+vec2(1.7,9.2); a*=0.5; }
    return v;
}
// Upward-scrolling fbm that loops seamlessly: two layers offset by one cycle, crossfaded.
float loopFbm(vec2 p, float t, float speed){
    float a = fbm(p + vec2(0.0, -t*speed));
    float b = fbm(p + vec2(0.0, -(t-1.0)*speed) + vec2(31.7, 17.3));
    float w = smoothstep(0.0, 1.0, t);
    float v = mix(a, b, w);
    // Restore contrast lost when averaging two uncorrelated layers.
    float k = sqrt(w*w + (1.0-w)*(1.0-w));
    return 0.5 + (v-0.5)/k;
}

vec3 fireColor(float x){
    x = clamp(x,0.0,1.0);
    vec3 c = mix(vec3(0.45,0.02,0.0), vec3(1.0,0.28,0.02), smoothstep(0.0,0.35,x));
    c = mix(c, vec3(1.0,0.7,0.18), smoothstep(0.35,0.7,x));
    c = mix(c, vec3(1.0,0.97,0.85), smoothstep(0.7,1.0,x));
    return c;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float t = fract(iTime);
    float ph = t*TAU;
    vec4 col = vec4(0.0);
    float flick = 0.85 + 0.1*sin(ph*3.0) + 0.05*sin(ph*5.0+1.0);

    // ---------- Torch handle ----------
    float baseY = -0.07;
    float hy = (uv.y + 0.44) / (baseY - 0.05 + 0.44);
    float halfW = mix(0.022, 0.04, clamp(hy,0.0,1.0));
    if(hy>0.0 && hy<1.0 && abs(uv.x) < halfW){
        float sx = uv.x/halfW;
        float shade = sqrt(max(0.0,1.0-sx*sx));
        float grain = noise(vec2(uv.x*60.0, uv.y*6.0))*0.5 + noise(vec2(uv.x*140.0, uv.y*14.0))*0.5;
        vec3 wood = mix(vec3(0.22,0.11,0.05), vec3(0.42,0.24,0.11), grain);
        wood *= 0.35 + 0.75*shade*(0.8 - 0.2*sx);
        wood += vec3(0.35,0.15,0.03)*smoothstep(0.4,1.0,hy)*shade*flick;
        col = vec4(wood,1.0);
    }
    // Metal bands
    for(int i=0;i<2;i++){
        float by = baseY - 0.07 - float(i)*0.17;
        float bw = 0.046 - float(i)*0.012;
        if(abs(uv.y-by) < 0.013 && abs(uv.x) < bw){
            float sx = uv.x/bw;
            float shade = sqrt(max(0.0,1.0-sx*sx));
            vec3 m = vec3(0.18,0.17,0.16)*(0.4+0.9*shade);
            m += vec3(0.35)*pow(shade,14.0);
            m += vec3(0.35,0.14,0.02)*shade*float(1-i)*flick;
            col = vec4(m,1.0);
        }
    }
    // Charred fuel head with glowing embers
    vec2 hp = uv - vec2(0.0, baseY-0.015);
    float head = length(hp*vec2(1.0,1.5)) - 0.055;
    if(head < 0.0){
        float n = noise(uv*90.0);
        vec3 c = vec3(0.07,0.05,0.04)*(0.6+0.8*n);
        float hot = smoothstep(0.45,0.8,noise(uv*60.0 + vec2(1.3*cos(ph), 1.3*sin(ph))));
        c += vec3(1.0,0.32,0.04)*hot*1.5;
        col = vec4(c,1.0);
    }

    // ---------- Flame ----------
    vec2 fp = uv - vec2(0.0, baseY);
    float H = 0.40;
    float h = fp.y / H;
    float sway = 0.014*sin(ph) + 0.006*sin(2.0*ph+1.3);
    fp.x -= sway * h * h * 3.0;

    vec2 np = vec2(fp.x*6.0, fp.y*4.5);
    float n1 = loopFbm(np, t, 5.0);
    float n2 = loopFbm(np*2.1 + vec2(5.3,1.1), t, 10.0);
    float n = n1*0.65 + n2*0.35;

    float hc = clamp(h, 0.0, 1.0);
    float width = 0.09 * pow(1.0 - hc, 0.65) * (0.6 + 0.4*smoothstep(-0.1, 0.2, h));
    float xd = abs(fp.x + (n1-0.5)*0.09*hc) / max(width, 1e-4);
    float shape = 1.0 - xd*xd*0.9 - hc*0.2;
    float dens = shape + (n - 0.5)*(1.0 + 2.0*hc);
    dens *= smoothstep(-0.015, 0.04, fp.y + (n2-0.5)*0.04);
    dens *= step(h, 1.15);
    dens = clamp(dens, 0.0, 1.0);

    float heat = dens * (1.2 - 0.7*hc);
    vec3 fc = fireColor(heat*1.1);
    float core = smoothstep(0.035, 0.0, abs(fp.x)) * smoothstep(0.08, 0.01, fp.y);
    fc = mix(fc, vec3(0.45,0.65,1.0), core*0.35);
    float fa = smoothstep(0.0, 0.2, dens);
    fc *= 1.0 + 0.5*smoothstep(0.6,1.0,heat);

    // Soft glow halo around the flame
    float gd = length((uv - vec2(sway*1.5, baseY + 0.13))*vec2(1.3, 0.75));
    float glow = exp(-gd*gd*90.0) * 0.45 * flick;

    // Rising sparks
    vec3 emb = vec3(0.0); float ea = 0.0;
    for(int i=0;i<14;i++){
        float fi = float(i);
        float life = fract(t + hash(vec2(fi, 3.7)));
        float x0 = (hash(vec2(fi, 9.1))-0.5)*0.08;
        float drift = (hash(vec2(fi, 1.3))-0.5)*0.1;
        vec2 ep = vec2(x0 + drift*life + 0.012*sin(life*TAU*2.0 + fi*2.0), baseY + 0.08 + life*0.32);
        float r = 0.007*(1.0-life*0.5);
        float d = length(uv-ep);
        float e = smoothstep(r, r*0.2, d) * (1.0-life) * smoothstep(0.0,0.15,life);
        emb += mix(vec3(1.0,0.9,0.6), vec3(1.0,0.4,0.05), life)*e*2.0;
        ea = max(ea, e);
    }

    vec3 rgb = col.rgb;
    float a = col.a;
    rgb = rgb*a + vec3(1.0,0.45,0.08)*glow;
    a = a + glow*(1.0-a);
    rgb = rgb*(1.0-fa) + fc*fa;
    a = a*(1.0-fa) + fa;
    rgb += emb; a = max(a, ea);
    a = clamp(a, 0.0, 1.0);
    rgb = a > 0.0 ? rgb / a : vec3(0.0);
    fragColor = vec4(clamp(rgb,0.0,1.0), a);
}

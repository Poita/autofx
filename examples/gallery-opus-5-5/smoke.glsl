// Generated by: autofx 'puff of smoke' -d 1.2 -f 36 -s -o examples/gallery-opus-5-5/smoke.gif
// Render with:  autofx examples/gallery-opus-5-5/smoke.glsl -d 1.2 -r 256x256 -f 36 -s -o examples/gallery-opus-5-5/smoke.gif

float hash(vec2 p){ p = fract(p*vec2(123.34,456.21)); p += dot(p,p+45.32+iSeed); return fract(p.x*p.y); }
float noise(vec2 p){
    vec2 i=floor(p), f=fract(p);
    vec2 u=f*f*f*(f*(f*6.0-15.0)+10.0);
    return mix(mix(hash(i),hash(i+vec2(1,0)),u.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),u.x), u.y);
}
float fbm(vec2 p){
    float v=0.0, a=0.5;
    mat2 r=mat2(0.8,0.6,-0.6,0.8);
    for(int i=0;i<6;i++){ v+=a*noise(p); p=r*p*2.03+11.7; a*=0.5; }
    return v;
}

// Sum of gaussian lobes: a central core plus a ring of billows that expand outward and rise.
float density(vec2 p, float t){
    float e = 1.0 - pow(1.0 - clamp(t/0.85,0.0,1.0), 3.0);
    float rise = 0.07*t;
    float d = 0.0;
    vec2 q = p - vec2(0.0, rise*0.6);
    float r = 0.06 + 0.12*e;
    d += exp(-dot(q,q)/(r*r)*1.4);
    for(int i=0;i<9;i++){
        float fi=float(i);
        float h1 = fract(sin(fi*12.9+iSeed)*437.5);
        float h2 = fract(sin(fi*7.1+iSeed)*93.1);
        float a = fi/9.0*6.2831 + 0.5*sin(fi*3.7+iSeed);
        float dist = (0.17 + 0.07*h1)*e;
        vec2 c = vec2(cos(a),sin(a)*0.8)*dist + vec2(0.0, rise);
        float rr = (0.035 + 0.085*e)*(0.75+0.5*h2);
        q = p - c;
        d += 0.9*exp(-dot(q,q)/(rr*rr)*1.6);
    }
    return d;
}

float field(vec2 p, float t){
    vec2 w = vec2(fbm(p*5.0 + vec2(0.0,-t*0.8) + iSeed), fbm(p*5.0 + vec2(5.2,1.3) - t*0.6 + iSeed));
    vec2 pw = p + (w-0.5)*0.08*(0.4+t);
    float detail = fbm(pw*7.0 - p*t*2.5 + iSeed*1.7);
    return density(pw, t) * (0.55 + 0.9*detail);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = fragCoord/iResolution.xy;
    vec2 p = uv - vec2(0.5, 0.46);
    float t = iTime;

    float d = field(p, t);
    // erosion: threshold rises so the puff breaks apart into wisps as it dissipates
    float thr = mix(0.3, 1.3, smoothstep(0.3, 1.15, t));
    float a = smoothstep(thr, thr + 0.45, d);
    a *= smoothstep(0.0, 0.05, t) * (1.0 - smoothstep(0.5, 1.15, t));

    // treat density as a height field and light it from the upper left
    float eps = 2.0/iResolution.y;
    vec2 g = vec2(field(p+vec2(eps,0.0),t)-field(p-vec2(eps,0.0),t),
                  field(p+vec2(0.0,eps),t)-field(p-vec2(0.0,eps),t)) / (2.0*eps);
    vec3 n = normalize(vec3(-g*0.018, 1.0));
    float diff = clamp(dot(n, normalize(vec3(-0.5,0.7,0.6))), 0.0, 1.0);
    float thick = clamp((d - thr)*0.8, 0.0, 1.0);
    vec3 shadow = vec3(0.38,0.38,0.43);
    vec3 lit = vec3(0.96,0.95,0.92);
    vec3 col = mix(shadow, lit, diff*0.65 + 0.35*thick);
    col = mix(col, vec3(0.72,0.72,0.75), smoothstep(0.45,1.1,t)*0.5);

    if (t >= 1.15) a = 0.0;
    fragColor = vec4(col, clamp(a,0.0,1.0));
}
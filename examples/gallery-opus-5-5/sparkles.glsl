// Generated by: autofx 'twinkling magic sparkles' -d 1.5 -f 45 --loop -s -o examples/gallery-opus-5-5/sparkles.gif
// Render with:  autofx examples/gallery-opus-5-5/sparkles.glsl -d 1.5 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5/sparkles.gif

#define TAU 6.28318530718
#define DUR 1.5
#define N 55

float hash1(float n) { return fract(sin(n * 127.1 + iSeed * 13.7) * 43758.5453); }

vec3 palette(float h) {
    vec3 gold = vec3(1.0, 0.78, 0.3);
    vec3 pink = vec3(1.0, 0.4, 0.85);
    vec3 cyan = vec3(0.35, 0.8, 1.0);
    vec3 lav  = vec3(0.7, 0.5, 1.0);
    if (h < 0.35) return gold;
    if (h < 0.6) return pink;
    if (h < 0.8) return cyan;
    return lav;
}

// Four-pointed star: thin long rays, shorter diagonal rays, soft halo.
float sparkle(vec2 d, float size, float rot) {
    float c = cos(rot), s = sin(rot);
    d = mat2(c, -s, s, c) * d;
    float r = length(d);
    float core = exp(-r * r / (size * size * 0.004));
    float glow = 0.5 * exp(-r / (size * 0.18));
    vec2 a = abs(d);
    float w = size * 0.03;
    float ray1 = exp(-a.y / w) * exp(-a.x / (size * 0.4));
    float ray2 = exp(-a.x / w) * exp(-a.y / (size * 0.4));
    vec2 q = mat2(0.7071, -0.7071, 0.7071, 0.7071) * d;
    vec2 b = abs(q);
    float ray3 = 0.5 * (exp(-b.y / w) * exp(-b.x / (size * 0.15))
                      + exp(-b.x / w) * exp(-b.y / (size * 0.15)));
    return 2.0 * core + glow + ray1 + ray2 + ray3;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 uv = (fragCoord - 0.5 * iResolution.xy) / iResolution.y;
    float ph = fract(iTime / DUR);
    vec3 col = vec3(0.0);
    float white = 0.0;

    for (int i = 0; i < N; i++) {
        float fi = float(i);
        float h1 = hash1(fi), h2 = hash1(fi + 17.3), h3 = hash1(fi + 41.9);
        float h4 = hash1(fi + 73.1), h5 = hash1(fi + 91.7);

        // Positions within a disc with a small cyclic drift.
        float ang = h1 * TAU;
        float rad = 0.3 * sqrt(h2);
        vec2 p = rad * vec2(cos(ang), sin(ang));
        float driftA = TAU * (ph + h3);
        p += 0.015 * vec2(cos(driftA), sin(driftA) * (h4 < 0.5 ? 1.0 : -1.0));

        // Integer cycles per loop keep the twinkle perfectly periodic.
        float k = floor(1.0 + h4 * 2.99);
        float tw = 0.5 + 0.5 * sin(TAU * (ph * k + h5));
        tw = pow(tw, 4.0);

        float size = mix(0.07, 0.17, h3 * h3) * (0.35 + 0.65 * tw);
        float rot = 0.3 * sin(TAU * (ph + h1));

        float s = sparkle(uv - p, size, rot) * tw;
        col += palette(fract(h2 + h5)) * s;
        white += s * s;
    }

    // Fine glitter dust.
    for (int j = 0; j < 50; j++) {
        float fj = float(j) + 200.0;
        float ang = hash1(fj) * TAU;
        float rad = 0.34 * sqrt(hash1(fj + 3.1));
        vec2 p = rad * vec2(cos(ang), sin(ang));
        float tw = pow(0.5 + 0.5 * sin(TAU * (ph * 2.0 + hash1(fj + 7.7))), 8.0);
        float r = length(uv - p);
        col += palette(hash1(fj + 9.9)) * (exp(-r * r / 0.00003) + 0.3 * exp(-r / 0.006)) * tw;
    }

    col += vec3(white) * 0.3;
    col = 1.0 - exp(-col * 1.6);
    float a = clamp(max(col.r, max(col.g, col.b)), 0.0, 1.0);
    a = smoothstep(0.0, 0.5, a);
    fragColor = vec4(clamp(col, 0.0, 1.0), a);
}

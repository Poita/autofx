#define PI 3.14159265

float hash1(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }

float sdSeg(vec2 p, vec2 a, vec2 b){
    vec2 pa=p-a, ba=b-a;
    float h=clamp(dot(pa,ba)/dot(ba,ba),0.,1.);
    return length(pa-ba*h);
}

mat2 rot(float a){ float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }

float crystal(vec2 p, float L, float tw){
    float a = atan(p.y,p.x);
    float r = length(p);
    float sect = PI/3.0;
    a = mod(a + sect*0.5, sect) - sect*0.5;
    vec2 q = vec2(cos(a), abs(sin(a))) * r;
    float d = sdSeg(q, vec2(0), vec2(L,0)) - tw*(1.0 - 0.7*clamp(q.x/max(L,1e-3),0.,1.));
    for(int i=1;i<=4;i++){
        float fi=float(i);
        float x0 = L*(0.18+0.19*fi);
        float bl = L*0.32*(1.0-fi*0.17);
        if(x0 > L) break;
        vec2 b0 = vec2(x0,0);
        vec2 b1 = b0 + bl*vec2(cos(PI/3.0), sin(PI/3.0));
        d = min(d, sdSeg(q,b0,b1) - tw*0.55);
    }
    return d;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy) / (0.5*iResolution.y);
    float t = iTime;
    float fadeOut = 1.0 - smoothstep(0.7, 1.12, t);
    vec3 col = vec3(0);
    float alpha = 0.0;

    vec3 iceA = vec3(0.45,0.8,1.0);
    vec3 iceB = vec3(0.85,0.97,1.0);

    float grow = 1.0 - pow(1.0 - clamp(t/0.32,0.,1.), 3.0);
    float L = 0.55*grow;
    float crystFade = 1.0 - smoothstep(0.36, 0.55, t);
    vec2 cp = rot(0.25*t + iSeed) * p;
    float crackN = fract(sin(dot(floor(cp*22.0), vec2(12.9,78.2))+iSeed)*43758.5);
    float dissolve = smoothstep(crackN-0.1, crackN+0.1, crystFade*1.1);
    if(L>0.001){
        float d = crystal(cp, L, 0.022);
        float body = smoothstep(0.006, -0.004, d);
        float glow = exp(-max(d,0.0)*45.0);
        float facet = 0.5+0.5*sin(atan(cp.y,cp.x)*6.0 + length(cp)*30.0);
        vec3 c = mix(iceA, iceB, facet) * body * 1.2 + iceA*glow*0.5;
        float a = max(body, glow*0.45);
        float k = crystFade * mix(1.0, dissolve, smoothstep(0.33,0.42,t));
        col += c*k; alpha += a*k;
    }

    float fl = exp(-pow((t-0.08)/0.09,2.0));
    float rc = length(p);
    float flash = fl*(exp(-rc*rc*60.0)*1.5 + 0.25*exp(-rc*7.0));
    float ang = atan(p.y,p.x);
    float rays = pow(abs(cos(ang*3.0 + iSeed)), 40.0) * exp(-rc*5.0) * fl;
    col += vec3(0.9,0.98,1.0)*(flash+rays);
    alpha += flash+rays;

    float ringR = 0.75*(1.0-exp(-t*5.0));
    float ringW = 0.015 + 0.03*t;
    float ring = exp(-pow((rc-ringR)/ringW,2.0)) * (1.0 - smoothstep(0.1,0.6,t)) * smoothstep(0.0,0.05,t);
    float ringN = 0.6+0.4*sin(ang*23.0+iSeed*3.0)*sin(ang*7.0 - t*4.0);
    col += iceA*ring*ringN*0.8; alpha += ring*ringN*0.6;

    for(int i=0;i<48;i++){
        float fi=float(i);
        float h1=hash1(fi), h2=hash1(fi+31.7), h3=hash1(fi+77.3), h4=hash1(fi+5.1);
        float st = 0.22 + 0.18*h3;
        float lt = t - st;
        if(lt < 0.0) continue;
        float dirA = (floor(h1*6.0)+ (h2-0.5)*0.9)*PI/3.0 + iSeed;
        vec2 dir = vec2(cos(dirA), sin(dirA));
        float r0 = 0.1 + 0.4*h4;
        float maxR = min(0.82, r0 + 0.25 + 0.25*h2);
        float rr = r0 + (maxR - r0)*(1.0-exp(-lt*4.5));
        vec2 c = dir*rr;
        float spin = (h1-0.5)*14.0*lt + h3*6.28;
        vec2 q = rot(spin)*(p-c);
        float sz = 0.02 + 0.03*h3*(1.0 - 0.6*lt);
        q.x *= 0.45;
        float d = abs(q.x)+abs(q.y) - sz*0.5;
        float life = smoothstep(0.0,0.03,lt) * (1.0 - smoothstep(0.3, 0.75, lt));
        float body = smoothstep(0.004, -0.002, d);
        float edge = smoothstep(0.0, -sz*0.25, d);
        float glint = 0.7+0.8*pow(abs(sin(spin*2.0)),8.0);
        float g = exp(-max(d,0.0)*120.0)*0.35;
        vec3 sc = mix(iceA, iceB, edge*0.7+h2*0.3);
        col += sc*(body*glint + g)*life;
        alpha += (body + g)*life;
    }

    for(int i=0;i<36;i++){
        float fi=float(i)+100.0;
        float h1=hash1(fi), h2=hash1(fi+3.3), h3=hash1(fi+9.9);
        float st = 0.1+0.5*h3;
        float lt = t-st;
        if(lt<0.0) continue;
        float a = h1*6.2832;
        float rr = (0.15+0.6*h2)*(0.8+0.2*(1.0-exp(-lt*4.0)));
        vec2 c = vec2(cos(a),sin(a))*rr;
        vec2 d = p-c;
        float tw = exp(-pow((lt-0.12)/0.08,2.0));
        float star = exp(-dot(d,d)*4000.0)
                   + exp(-abs(d.x)*300.0)*exp(-abs(d.y)*45.0)
                   + exp(-abs(d.y)*300.0)*exp(-abs(d.x)*45.0);
        star *= tw;
        col += vec3(0.85,0.95,1.0)*star;
        alpha += star*0.8;
    }

    col *= fadeOut; alpha = clamp(alpha*fadeOut, 0.0, 1.0);
    if(t >= 1.15){ col = vec3(0); alpha = 0.0; }
    fragColor = vec4(col, alpha);
}
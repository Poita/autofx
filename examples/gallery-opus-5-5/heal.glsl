// Generated by: autofx 'green healing aura with rising particles' -d 2.0 -f 45 --loop -s -o examples/gallery-opus-5-5/heal.gif
// Render with:  autofx examples/gallery-opus-5-5/heal.glsl -d 2.0 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5/heal.gif

#define TAU 6.28318530718
#define DUR 2.0

float hash11(float p){ p=fract(p*0.1031); p*=p+33.33; p*=p+p; return fract(p); }

float vnoise(vec3 p){
    vec3 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    float n=i.x+i.y*57.0+i.z*113.0;
    float a=mix(mix(hash11(n),hash11(n+1.0),f.x),mix(hash11(n+57.0),hash11(n+58.0),f.x),f.y);
    float b=mix(mix(hash11(n+113.0),hash11(n+114.0),f.x),mix(hash11(n+170.0),hash11(n+171.0),f.x),f.y);
    return mix(a,b,f.z);
}
float fbm(vec3 p){ float s=0.0,a=0.5; for(int i=0;i<5;i++){ s+=a*vnoise(p); p=p*2.03+vec3(1.7,9.2,4.1); a*=0.5;} return s; }

// upward-scrolling noise that loops exactly over one cycle
float loopNoise(vec2 p, float ph, vec2 cyc, float speed){
    float a=fbm(vec3(p.x, p.y-ph*speed, 0.0)+vec3(cyc,0.0));
    float b=fbm(vec3(p.x, p.y-(ph-1.0)*speed, 0.0)+vec3(cyc,0.0));
    return mix(a,b,ph);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float ph=fract(iTime/DUR);
    float ang=ph*TAU;
    vec2 cyc=vec2(cos(ang),sin(ang))*0.5;
    float pulse=0.5+0.5*sin(ang);

    vec3 mid=vec3(0.3,1.0,0.4), hot=vec3(0.9,1.0,0.75);
    vec3 col=vec3(0.0);
    float alpha=0.0;

    // aura column: vertical wisps inside a tapered capsule
    vec2 p=uv-vec2(0.0,-0.02);
    float h=clamp((p.y+0.3)/0.62,0.0,1.0);
    float n=loopNoise(vec2(p.x*7.0,p.y*2.5),ph,cyc,4.0);
    float n2=loopNoise(vec2(p.x*12.0+5.0,p.y*4.0),ph,-cyc,6.0);
    float width=mix(0.23,0.07,h*h);
    float sx=abs(p.x)/width;
    float sy=abs(p.y+0.02)/0.33;
    float shape=1.0-length(vec2(sx,sy));
    float field=shape+(n-0.5)*1.1*(0.3+h)+(n2-0.5)*0.4;
    float aura=smoothstep(0.0,0.55,field);
    float wisps=smoothstep(0.55,0.75,n2)*smoothstep(-0.2,0.3,field)*0.8;
    float rim=smoothstep(0.0,0.12,field)*(1.0-smoothstep(0.12,0.4,field));
    aura*=0.65+0.25*pulse;

    float d=length(vec2(p.x*1.2,(p.y+0.05)*0.85));
    float glow=exp(-d*d*22.0)*(0.45+0.15*pulse);

    // ground rings and an expanding ripple
    vec2 rp=uv-vec2(0.0,-0.32);
    float rr=length(vec2(rp.x,rp.y*3.3));
    float ringR=0.25+0.012*sin(ang);
    float ring=exp(-pow((rr-ringR)/0.014,2.0))*(0.75+0.25*pulse);
    float ring2=exp(-pow((rr-ringR*0.82)/0.008,2.0))*0.45;
    float ringFill=exp(-rr*rr*25.0)*0.5;
    float wr=0.04+ph*0.24;
    float wave=exp(-pow((rr-wr)/0.016,2.0))*(1.0-ph)*smoothstep(0.0,0.12,ph)*0.7;

    col+=mid*glow*0.8;
    col+=mix(mid,hot,smoothstep(0.3,1.0,aura))*aura;
    col+=hot*(rim*0.35+wisps*0.6);
    col+=mix(mid,hot,0.5)*(ring+ring2+wave)+mid*ringFill;
    alpha=max(alpha, glow);
    alpha=max(alpha, aura);
    alpha=max(alpha, wisps);
    alpha=max(alpha, ring+ring2+wave);
    alpha=max(alpha, ringFill);

    // rising particles; integer cycles per loop keep them seamless
    for(int i=0;i<70;i++){
        float fi=float(i);
        float r1=hash11(fi*1.31+iSeed), r2=hash11(fi*7.17+3.1+iSeed), r3=hash11(fi*3.77+9.4+iSeed);
        float speedCycles=1.0+floor(r3*2.0);
        float life=fract(ph*speedCycles+r1);
        float x0=(r2-0.5)*0.44;
        float sway=0.025*sin(life*TAU+fi)*(0.5+r3);
        vec2 pos=vec2(x0*(1.0-0.35*life)+sway, -0.32+life*0.64);
        float fade=smoothstep(0.0,0.15,life)*(1.0-smoothstep(0.55,1.0,life));
        float size=mix(0.0035,0.008,r3)*(1.0-0.4*life);
        vec2 q=uv-pos;
        float dd=length(q);
        float core=exp(-dd*dd/(size*size));
        float halo=exp(-dd*dd/(size*size*12.0))*0.4;
        float tl=size*6.0;
        float ty=clamp(-q.y,0.0,tl);
        float trail=exp(-pow(length(vec2(q.x,q.y+ty))/size,2.0)*1.5)*(1.0-ty/tl)*0.35*step(q.y,0.0);
        float tw=0.7+0.3*sin(life*TAU*3.0+fi*2.0);
        float spark=0.0;
        if(i%5==0){
            float s=size*2.4;
            float cr=min(max(abs(q.x)-s*0.3,abs(q.y)-s), max(abs(q.y)-s*0.3,abs(q.x)-s));
            spark=smoothstep(0.002,-0.001,cr);
        }
        float v=(core+halo+spark+trail)*fade*tw;
        col+=mix(mid,hot,0.5+0.5*core)*v;
        alpha=max(alpha,clamp(v,0.0,1.0));
    }

    alpha=clamp(alpha,0.0,1.0);
    col=1.0-exp(-col*1.4);
    fragColor=vec4(col, alpha);
}

// Render with:  autofx examples/gallery-opus-5-5/shock.glsl -d 0.5 -r 256x256 -f 20 -s -o examples/gallery-opus-5-5/shock.gif

float h11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
float n1(float x){ float i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f); return mix(h11(i),h11(i+1.0),f)*2.0-1.0; }
float fbm1(float x){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*n1(x); x*=2.1; a*=0.5; } return v; }

float bolt(vec2 p, vec2 o, float ang, float L, float seed, float width){
    vec2 dir=vec2(cos(ang),sin(ang)), nrm=vec2(-dir.y,dir.x);
    vec2 q=p-o;
    float s=dot(q,dir);
    float sc=clamp(s,0.0,L);
    float env=sin(3.14159*sc/L*0.5);
    float off=fbm1(sc*14.0+seed*31.0)*0.09*env;
    float d=abs(dot(q,nrm)-off);
    float along=max(-s,0.0)+max(s-L,0.0);
    d=length(vec2(d,along));
    float taper=1.0-smoothstep(0.6*L,L,sc);
    float core=width/(d+width*0.3)*exp(-d*30.0);
    return core*taper;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float t=iTime;
    float env=smoothstep(0.0,0.04,t)*(1.0-smoothstep(0.26,0.46,t));
    float frame=floor(t*36.0);
    float flick=0.65+0.35*h11(frame*3.1+7.0);
    float grow=smoothstep(0.0,0.12,t);

    float I=0.0;
    for(int i=0;i<7;i++){
        float fi=float(i);
        float sd=fi*5.3+frame*1.7;
        float ang=fi*6.2832/7.0+h11(fi*9.1)*0.6+(h11(sd)-0.5)*0.25;
        float L=(0.24+0.13*h11(fi*4.7+frame))*grow;
        I+=bolt(p,vec2(0.0),ang,L,sd,0.0026);
        vec2 dir=vec2(cos(ang),sin(ang));
        float bs=L*(0.35+0.3*h11(sd+2.0));
        vec2 bo=dir*bs+vec2(-dir.y,dir.x)*fbm1(bs*14.0+sd*31.0)*0.09*sin(3.14159*bs/L*0.5);
        float bang=ang+(h11(sd+3.0)>0.5?1.0:-1.0)*(0.5+0.4*h11(sd+4.0));
        I+=0.7*bolt(p,bo,bang,L*0.45,sd+11.0,0.0018);
    }
    float r=length(p);
    float coreGlow=0.001/(r*r+0.004)*exp(-r*8.0);
    float halo=exp(-r*r*40.0)*0.6;
    I=I*flick+coreGlow*(0.8+0.4*flick)+halo*flick;
    I*=env;

    vec3 col=vec3(0.35,0.55,1.0)*I + vec3(0.8,0.9,1.0)*pow(max(I-0.6,0.0),1.5);
    col=1.0-exp(-col*1.4);
    float a=clamp(max(col.r,max(col.g,col.b)),0.0,1.0);
    a*=smoothstep(0.004,0.03,a);
    fragColor=vec4(col,a);
}

// Render with:  autofx examples/gallery-opus-5-5/firework.glsl -d 1.0 -r 256x256 -f 40 -s -o examples/gallery-opus-5-5/firework.gif

float h11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
vec3 hsv(float h,float s,float v){ vec3 k=clamp(abs(mod(h*6.0+vec3(0,4,2),6.0)-3.0)-1.0,0.0,1.0); return v*mix(vec3(1),k,s); }

vec2 ppos(vec2 dir, float spd, float t){
    float k=3.5;
    return dir*spd*(1.0-exp(-k*t))/k + vec2(0.0,-0.1)*t*t;
}
float sdSeg(vec2 p, vec2 a, vec2 b, out float h){
    vec2 pa=p-a, ba=b-a;
    h=clamp(dot(pa,ba)/max(dot(ba,ba),1e-8),0.0,1.0);
    return length(pa-ba*h);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    uv.y-=0.05;
    float t=iTime;
    vec3 col=vec3(0);
    float baseHue=h11(1.0);

    float flash=exp(-t*12.0);
    float r=length(uv);
    col+=vec3(1.0,0.85,0.6)*flash*exp(-r*r*120.0)*2.5;
    col+=vec3(1.0,0.7,0.4)*flash*exp(-r*r*25.0)*0.5;

    float fadeIn=smoothstep(0.0,0.03,t);
    float life=1.0-smoothstep(0.4,0.92,t);
    const int N=150;
    const int S=8;
    float trailLen=0.10;
    for(int i=0;i<N;i++){
        float fi=float(i);
        float a=fi/float(N)*6.2831+h11(fi)*0.12;
        float ring=h11(fi+7.0);
        float spd=mix(0.8,1.15,ring);
        if(i%3==0) spd*=0.55;
        vec2 dir=vec2(cos(a),sin(a));
        float sector=floor(fract(fi/float(N)+0.13*ring)*5.0);
        float hue=baseHue+sector*0.2+(i%3==0?0.5:0.0);
        vec3 pc=hsv(fract(hue),0.85,1.0);
        float plife=life*(0.7+0.3*h11(fi+3.0));
        float tw=0.7+0.3*sin(t*55.0+fi*3.7);
        vec2 prev=ppos(dir,spd,t);
        float dh=length(uv-prev);
        vec3 headC=mix(pc,vec3(1.0),0.6);
        col+=headC*(exp(-dh*dh*1.2e5)*1.6+exp(-dh*dh*6e3)*0.25)*plife*tw*fadeIn;
        for(int j=1;j<=S;j++){
            float fj=float(j)/float(S);
            float tt=max(t-fj*trailLen,0.0);
            vec2 p=ppos(dir,spd,tt);
            float h;
            float d=sdSeg(uv,prev,p,h);
            float w=1.0-(fj-h/float(S));
            w=w*w;
            col+=pc*(exp(-d*d*1.6e5)*0.9+exp(-d*d*8e3)*0.08)*w*plife*fadeIn;
            prev=p;
        }
    }
    float sp=smoothstep(0.35,0.5,t)*(1.0-smoothstep(0.65,0.9,t));
    for(int i=0;i<70;i++){
        float fi=float(i)+300.0;
        float a=h11(fi)*6.2831;
        float rr=sqrt(h11(fi+1.0));
        vec2 p=ppos(vec2(cos(a),sin(a)),rr*1.1,t);
        float d=length(uv-p);
        float blink=step(0.55,fract(t*14.0+h11(fi+2.0)));
        col+=vec3(1.0,0.95,0.8)*(exp(-d*d*8e4)*1.5+exp(-d*d*4e3)*0.15)*blink*sp;
    }

    col=1.0-exp(-col*1.4);
    float al=clamp(max(col.r,max(col.g,col.b))*1.2,0.0,1.0);
    if(t>=0.999){ col=vec3(0); al=0.0; }
    fragColor=vec4(col,al);
}
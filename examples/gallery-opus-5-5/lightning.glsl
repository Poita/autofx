float h11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
float vn(float x){ float i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f); return mix(h11(i),h11(i+1.0),f)*2.0-1.0; }
float sdSeg(vec2 p, vec2 a, vec2 b){ vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/dot(ba,ba),0.0,1.0); return length(pa-ba*h); }
vec2 mainPt(float s, float seed){
    float x = vn(s*4.0+seed)*0.13 + vn(s*11.0+seed*2.1)*0.05 + vn(s*29.0+seed*3.7)*0.02;
    x *= sin(3.14159*s)*0.6+0.4;
    return vec2(0.5 + x, mix(0.90, 0.12, s));
}
vec2 branchPt(float s, vec2 o, float dir, float len, float seed){

// Generated by: autofx 'circle of glowing golden runes' -d 2.0 -f 45 --loop -s -o examples/gallery-opus-5-5/runes.gif
// Render with:  autofx examples/gallery-opus-5-5/runes.glsl -d 2.0 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5/runes.gif

#define TAU 6.2831853
#define NR 12.0

float hash(float n){ return fract(sin(n*127.1 + iSeed*13.7)*43758.5453); }

float seg(vec2 p, vec2 a, vec2 b){
    vec2 pa=p-a, ba=b-a;
    float h=clamp(dot(pa,ba)/dot(ba,ba),0.,1.);
    return length(pa-ba*h);
}

// Point on a 3x3 glyph grid, index 0..8.
vec2 gp(float k){
    float x=mod(k,3.0), y=floor(k/3.0);
    return vec2(x-1.0, y-1.0)*vec2(0.55,0.8);
}

// Procedural rune: optional central stave plus 3 random strokes on the grid.
float rune(vec2 p, float id){
    float d=1e5;
    if(hash(id*3.1)>0.3) d=min(d,seg(p,gp(1.),gp(7.)));
    for(int i=0;i<3;i++){
        float fi=float(i);
        float a=floor(hash(id*7.3+fi*1.7)*9.0);
        float b=floor(hash(id*5.9+fi*3.3+11.0)*9.0);
        if(a==b) b=mod(b+4.0,9.0);
        d=min(d,seg(p,gp(a),gp(b)));
    }
    return d;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float ph=TAU*fract(iTime/2.0);
    float r=length(uv);
    float a=atan(uv.y,uv.x);
    float pulse=0.85+0.15*sin(ph);

    // Rune ring: runes stay fixed, a highlight sweeps once around per loop.
    float R=0.33, S=0.042;
    float cell=TAU/NR;
    float ca=a+cell*0.5;
    float idx=floor(ca/cell);
    float la=mod(ca,cell)-cell*0.5;
    vec2 lp=vec2(la*R, r-R)/S;
    float id=mod(idx,NR);
    float dr=rune(lp,id)*S;
    float sweep=pow(0.5+0.5*cos(idx*cell-ph),6.0);
    float rb=0.55+0.12*sin(ph*2.0+id*1.3)+sweep*1.1;
    float core=smoothstep(0.005,0.002,dr);
    float glow=exp(-dr*90.0)*0.5+exp(-dr*250.0)*0.6;
    float runeI=(core+glow)*rb*pulse;

    // Concentric rings.
    float r1=abs(r-0.245), r2=abs(r-0.405), r3=abs(r-0.425);
    float rings=exp(-r1*450.0)+exp(-r2*450.0)+0.6*exp(-r3*550.0);
    rings+=0.12*(exp(-r1*120.0)+exp(-r2*120.0));
    // Tick marks advance exactly one spacing per loop; dashes counter-rotate likewise.
    float ta=a*72.0/TAU - fract(iTime/2.0);
    float tick=smoothstep(0.1,0.03,abs(fract(ta)-0.5))*smoothstep(0.008,0.003,abs(r-0.415));
    float da=a*24.0/TAU + fract(iTime/2.0);
    float dash=smoothstep(0.45,0.5,fract(da))*smoothstep(0.004,0.0015,abs(r-0.228));

    // Hexagram rotates 60 degrees per loop (its symmetry period).
    float star=1e5;
    for(int i=0;i<6;i++){
        float a0=float(i)*TAU/6.0 + ph/6.0;
        float a1=a0+2.0*TAU/6.0;
        star=min(star,seg(uv,0.205*vec2(cos(a0),sin(a0)),0.205*vec2(cos(a1),sin(a1))));
    }
    float starI=(smoothstep(0.0035,0.0012,star)+exp(-star*160.0)*0.35)*0.7;

    float sweepRing=pow(0.5+0.5*cos(a-ph),8.0);
    float I=runeI + (rings+tick*0.8+dash*0.6)*(0.6+0.7*sweepRing)*pulse + starI*pulse;
    I+=0.08*exp(-pow((r-0.33)/0.07,2.0))*pulse*(0.5+sweepRing);

    vec3 gold=vec3(1.0,0.7,0.22);
    vec3 col=gold*I + vec3(1.0,0.95,0.8)*smoothstep(0.9,2.2,I);
    col=1.0-exp(-col*1.8);
    float alpha=clamp(max(col.r,max(col.g,col.b))*1.2,0.0,1.0);
    vec3 c=col/max(alpha,1e-3);
    fragColor=vec4(clamp(c,0.0,1.0),alpha);
}
// Generated by: autofx 'puff of smoke, aim for AAA quality' -d 1.2 -f 36 -s -o examples/gallery-opus-5-5-aaa/smoke.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/smoke.glsl -d 1.2 -r 256x256 -f 36 -s -o examples/gallery-opus-5-5-aaa/smoke.gif

float hash(vec3 p){p=fract(p*0.3183099+.1);p*=17.0;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}
float noise(vec3 x){vec3 i=floor(x);vec3 f=fract(x);f=f*f*(3.0-2.0*f);
return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),
mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);}
const mat3 M=mat3(0.0,0.8,0.6,-0.8,0.36,-0.48,-0.6,-0.48,0.64);
float fbm(vec3 p,int oct){float a=0.5,s=0.0,n=0.0;
for(int i=0;i<7;i++){if(i>=oct)break;s+=a*noise(p);n+=a;p=M*p*2.02;a*=0.5;}return s/n;}

float T;
float gExp, gFade, gErode;
vec3 gCenter;

// Smooth union of spheres flung outward from the puff origin
float blobField(vec3 p){
    float d=1e5;
    float seed=iSeed*13.7;
    for(int i=0;i<11;i++){
        float fi=float(i);
        vec3 dir=vec3(0.0);
        if(i>0){
            float a=fi*2.39996+seed;
            float z=fract(fi*0.618+0.13+seed*0.1)*1.8-0.9;
            float r=sqrt(1.0-z*z);
            dir=vec3(cos(a)*r,sin(a)*r*0.75+0.1,z);
        }
        float br=(i==0?0.42:0.26+0.12*hash(vec3(fi,seed,3.0)));
        float spread=0.42*(0.8+0.4*hash(vec3(fi,seed,7.0)));
        vec3 c=dir*spread*gExp+gCenter;
        float di=length(p-c)-br*gExp;
        float k=0.10*gExp+0.01;
        float h=clamp(0.5+0.5*(d-di)/k,0.0,1.0);
        d=mix(d,di,h)-k*h*(1.0-h);
    }
    return d;
}

float density(vec3 p,int oct){
    float d=blobField(p);
    float sc=max(gExp,0.05);
    if(d>0.30*sc) return 0.0;
    vec3 q=(p-gCenter)/sc;
    // domain warp that rolls the billows over time
    vec3 w=vec3(fbm(q*1.7+vec3(0.0,-T*1.2,iSeed),3),
                fbm(q*1.7+vec3(5.2,1.3-T*1.2,iSeed),3),
                fbm(q*1.7+vec3(2.1,7.7,iSeed-T),3));
    q+=(w-0.5)*0.6;
    float n=fbm(q*2.6,oct);
    float disp=(n-0.5)*0.55*sc;
    float detail=fbm(q*7.0+vec3(0.0,-T*2.0,0.0),3);
    // erosion eats the thin, low-detail regions first so the puff breaks into wisps
    float dd=d-disp+gErode*sc*(0.4+1.2*detail);
    float core=smoothstep(0.0,0.06*sc,-dd);
    float den=core*(0.55+0.9*detail);
    den+=smoothstep(0.12*sc,0.0,dd)*smoothstep(0.55,0.8,detail)*0.35*(1.0-core);
    return den*gFade;
}

void mainImage(out vec4 fragColor,in vec2 fragCoord){
    vec2 uv=(fragCoord*2.0-iResolution.xy)/iResolution.y;
    T=iTime;
    float t=clamp(T/1.2,0.0,1.0);
    gExp=1.2*(0.07+0.60*(1.0-pow(1.0-min(t*1.6,1.0),3.0))+0.14*t);
    gErode=smoothstep(0.2,1.0,t)*0.35;
    gFade=smoothstep(0.0,0.03,t)*pow(1.0-smoothstep(0.25,1.0,t),1.5);
    gCenter=vec3(0.0,-0.14+0.18*t,0.0);
    fragColor=vec4(0.0);
    if(gFade<=0.0) return;

    vec3 ro=vec3(uv,-2.0);
    vec3 rd=vec3(0.0,0.0,1.0);
    vec3 L=normalize(vec3(-0.5,0.8,-0.45));

    float bound=gExp*1.15+0.05;
    vec3 oc=ro-gCenter;
    float b=dot(oc,rd);
    float h=b*b-(dot(oc,oc)-bound*bound);
    if(h<0.0) return;
    h=sqrt(h);
    float t0=-b-h,t1=-b+h;
    const int STEPS=96;
    float dt=(t1-t0)/float(STEPS);
    float s=t0+dt*hash(vec3(fragCoord,floor(iTime*60.0)));
    float trans=1.0;
    vec3 col=vec3(0.0);
    float absorb=7.0/max(gExp,0.2);
    for(int i=0;i<STEPS;i++){
        vec3 p=ro+rd*s;
        float den=density(p,6);
        if(den>0.002){
            float sh=0.0;
            float ls=0.07*gExp+0.01;
            for(int j=1;j<=7;j++) sh+=density(p+L*ls*float(j)*(1.0+0.15*float(j)),4);
            float lt=exp(-sh*ls*absorb*1.1);
            float powder=1.0-exp(-den*3.0);
            float hgt=clamp((p.y-gCenter.y)/max(gExp,0.1)*0.6+0.5,0.0,1.0);
            vec3 sunCol=vec3(1.0,0.94,0.86)*1.35;
            vec3 skyCol=vec3(0.50,0.55,0.66);
            vec3 groundCol=vec3(0.30,0.27,0.26);
            vec3 cc=sunCol*lt*mix(0.5,1.0,powder)+mix(groundCol,skyCol,hgt)*0.75;
            // brief warm glow in the core at the moment of release
            float rr=length(p-gCenter)/max(gExp,0.05);
            cc+=vec3(1.4,0.65,0.25)*exp(-t*12.0)*smoothstep(0.6,0.0,rr)*1.5;
            cc*=vec3(0.80,0.80,0.82);
            float a=1.0-exp(-den*dt*absorb);
            col+=trans*a*cc;
            trans*=1.0-a;
            if(trans<0.005) break;
        }
        s+=dt;
    }
    float alpha=1.0-trans;
    fragColor=vec4(alpha>0.0?col/alpha:vec3(0.0),alpha);
}
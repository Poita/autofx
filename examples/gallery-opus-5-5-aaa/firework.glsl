float hash11(float p){ p = fract(p*0.1031); p *= p+33.33; p *= p+p; return fract(p); }
vec2 hash21(float p){ vec3 p3 = fract(vec3(p)*vec3(.1031,.1030,.0973)); p3 += dot(p3,p3.yzx+33.33); return fract((p3.xx+p3.yz)*p3.zy); }

const vec2 CENTER = vec2(0.0, 0.05);
const float T0 = 0.04;
const float GRAV = 0.2;

vec2 starPos(vec2 v, float k, float t){
    float s = max(t - T0, 0.0);
    return CENTER + v*(1.0-exp(-k*s))/k - vec2(0.0, GRAV*s*s);
}

float segDist(vec2 p, vec2 a, vec2 b, out float h){
    vec2 pa = p-a, ba = b-a;
    h = clamp(dot(pa,ba)/max(dot(ba,ba),1e-8),0.,1.);
    return length(pa-ba*h);
}

vec3 shell(vec2 p, float t, float N, float seed, float speed, float k, vec3 c1, vec3 c2, float lifeEnd, float trail, float size){
    vec3 col = vec3(0);
    float s = t - T0;
    if(s <= 0.0) return col;
    for(float i=0.; i<160.; i++){
        if(i>=N) break;
        float id = i + seed*17.31;
        vec2 r = hash21(id*1.37+seed);
        float ang = 6.2831853*(i + 0.6*(r.x-0.5))/N + seed;
        float z = r.y*2.0-1.0;
        float proj = sqrt(1.0 - z*z*0.8);
        float spd = speed*proj*(0.93+0.14*hash11(id*7.1));
        vec2 v = vec2(cos(ang), sin(ang))*spd;

        float pl = lifeEnd - 0.12*hash11(id*3.7);
        float life = 1.0 - smoothstep(pl-0.3, pl, t);
        if(life <= 0.0) continue;

        // trail spans recent history; tail fades out with age
        float L = min(s, trail);
        float glow = 0.0;
        float core = 0.0;
        const int SEG = 6;
        vec2 prev = starPos(v,k,t-L);
        for(int j=1;j<=SEG;j++){
            float f = float(j)/float(SEG);
            vec2 cur = starPos(v,k,t-L*(1.0-f));
            float h;
            float d = segDist(p, prev, cur, h);
            float w = mix(f-1.0/float(SEG), f, h);
            float age = (1.0-w)*L;
            float fall = exp(-age/(trail*0.3));
            glow += fall*exp(-d*d/0.00004);
            core += fall*exp(-d*d/0.000005);
            prev = cur;
        }
        vec2 head = starPos(v,k,t);
        float dh = length(p-head);
        float late = smoothstep(0.4, 0.65, t);
        float tw = mix(1.0, 0.25+1.6*step(0.5, hash11(floor(t*50.0)+id*13.0)), late);
        float headGlow = size*(2.2*exp(-dh*dh/(0.00001*size)) + 0.35*exp(-dh*dh/(0.00008*size)) + 0.000004/(dh*dh+0.00003)) * tw;

        float temp = smoothstep(0.0, 0.2, s);
        vec3 cc = mix(c1, c2, hash11(id*5.3)*0.4 + 0.6*smoothstep(0.25,0.8,t));
        vec3 tint = mix(vec3(1.0,0.95,0.85), cc, temp);
        vec3 trailTint = mix(vec3(1.0,0.75,0.4), cc, 0.6);
        col += (tint*headGlow + trailTint*(glow*0.4 + core*0.6)) * life;
    }
    return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float t = iTime;
    vec3 col = vec3(0);

    float fl = exp(-pow((t-T0)/0.025,2.0)) + 0.5*exp(-max(t-T0,0.0)*14.0)*step(T0,t);
    float dc = length(p-CENTER);
    col += vec3(1.0,0.9,0.75)*fl*(1.2*exp(-dc*dc/0.002) + 0.4*exp(-dc*dc/0.012));

    col += shell(p, t, 120., 1.0, 1.45, 4.0, vec3(1.0,0.1,0.5), vec3(1.0,0.65,0.1), 0.93, 0.35, 1.0);
    col += shell(p, t, 70., 2.0, 0.85, 4.0, vec3(0.1,0.55,1.0), vec3(0.2,1.0,0.4), 0.86, 0.3, 0.8);
    col += shell(p, t, 30., 3.0, 0.42, 4.5, vec3(1.0,0.35,0.0), vec3(0.7,0.2,1.0), 0.76, 0.25, 0.7);

    col = 1.0 - exp(-col*1.2);
    float fade = 1.0 - smoothstep(0.94, 0.99, t);
    float a = clamp(max(col.r,max(col.g,col.b))*1.2, 0.0, 1.0) * fade;
    fragColor = vec4(col*fade, a);
}
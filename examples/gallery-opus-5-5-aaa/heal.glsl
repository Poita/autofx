// Generated by: autofx 'green healing aura with rising particles, aim for AAA quality' -d 2.0 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/heal.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/heal.glsl -d 2.0 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/heal.gif

#define TAU 6.28318530718
const float DUR = 2.0;

float hash21(vec2 p){ p = fract(p*vec2(123.34,456.21)); p += dot(p,p+45.32); return fract(p.x*p.y); }

float vnoise(vec2 p, float py){
    vec2 i = floor(p), f = fract(p);
    vec2 u = f*f*f*(f*(f*6.0-15.0)+10.0);
    float y0 = mod(i.y, py), y1 = mod(i.y+1.0, py);
    float a = hash21(vec2(i.x, y0)), b = hash21(vec2(i.x+1.0, y0));
    float c = hash21(vec2(i.x, y1)), d = hash21(vec2(i.x+1.0, y1));
    return mix(mix(a,b,u.x), mix(c,d,u.x), u.y);
}
float fbm(vec2 p, float py){
    float s = 0.0, a = 0.5;
    for(int i=0;i<6;i++){ s += a*vnoise(p, py); p = p*2.0 + vec2(1.7,0.0); py *= 2.0; a *= 0.5; }
    return s;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float ph = fract(iTime/DUR);
    float seed = iSeed;
    vec3 col = vec3(0.0);
    float alpha = 0.0;

    float baseY = -0.30;
    float h = clamp((p.y - baseY)/0.62, 0.0, 1.0);
    float width = mix(0.26, 0.12, h) ;
    float xn = p.x/width;
    float PER = 4.0;
    vec2 q = vec2(p.x*5.0 + seed*13.0, (p.y)*PER*0.75 - ph*PER);
    float warp = fbm(q*0.8 + vec2(3.1, 0.0), PER) - 0.5;
    float n = fbm(vec2(q.x + warp*1.2, q.y), PER);
    float n2 = fbm(vec2(q.x*1.6 - 7.0 + warp, q.y*1.0 + 2.0), PER);
    float column = exp(-xn*xn*1.6);
    float vert = smoothstep(-0.03, 0.06, p.y - baseY) * pow(1.0 - h, 1.6);
    vert *= step(baseY - 0.05, p.y);
    float flame = column * vert;
    float wisps = flame * smoothstep(0.42, 0.78, n);
    float streak = pow(smoothstep(0.5, 0.85, n2), 2.0) * flame;
    float aura = wisps*1.6 + streak*1.2 + flame*0.3;

    vec3 deep = vec3(0.02, 0.35, 0.12);
    vec3 mid  = vec3(0.15, 0.9, 0.35);
    vec3 hot  = vec3(0.8, 1.0, 0.7);
    vec3 ac = mix(deep, mid, smoothstep(0.0, 0.5, aura));
    ac = mix(ac, hot, smoothstep(0.6, 1.1, aura));
    col += ac*aura;
    alpha += aura;

    vec2 e = vec2(p.x/0.30, (p.y - baseY)/0.075);
    float r = length(e);
    float pulse = 0.5 + 0.5*sin(ph*TAU*2.0);
    float ring = exp(-pow((r-1.0)*7.0, 2.0));
    float ringIn = exp(-pow((r-0.62)*14.0, 2.0)) * 0.5;
    float ang = atan(e.y, e.x);
    float runes = 0.6 + 0.4*sin(ang*12.0 + ph*TAU);
    float disk = smoothstep(1.05, 0.0, r) * 0.35;
    float ground = ring*(0.9 + 0.4*pulse) + ringIn*runes + disk*(0.7+0.3*pulse);
    for(int k=0;k<2;k++){
        float w = fract(ph + float(k)*0.5);
        float wr = mix(0.3, 1.15, w);
        ground += exp(-pow((r-wr)*10.0,2.0)) * (1.0-w)*(1.0-w) * 0.8;
    }
    vec3 gc = mix(mid, hot, clamp(ring*pulse,0.0,1.0)*0.6);
    col += gc*ground;
    alpha += ground;

    for(int i=0;i<48;i++){
        float fi = float(i);
        float h1 = hash21(vec2(fi, 1.3+seed)), h2 = hash21(vec2(fi, 7.9+seed)), h3 = hash21(vec2(fi, 3.7+seed));
        float speedK = (h3 < 0.5) ? 1.0 : 2.0;
        float lp = fract(ph*speedK + h1);
        float sx = (h2*2.0-1.0)*0.24;
        float y = baseY + lp*0.62 + (h3-0.5)*0.05;
        float x = sx*(1.0 - lp*0.45) + 0.025*sin(lp*TAU*1.5 + h1*TAU);
        float life = smoothstep(0.0, 0.12, lp)*smoothstep(1.0, 0.55, lp);
        float sz = mix(0.004, 0.009, h2*h3) * (1.0 - 0.5*lp);
        vec2 d = p - vec2(x, y);
        d.y *= 0.55;
        float dd = length(d);
        float core = smoothstep(sz, 0.0, dd);
        float glow = sz*sz*1.2/(dd*dd + sz*sz*0.6) * 0.35 * smoothstep(sz*14.0, sz*3.0, dd);
        float tw = 0.75 + 0.25*sin(ph*TAU*4.0 + h1*40.0);
        float I = (core*1.4 + glow)*life*tw;
        col += mix(mid, hot, core)*I;
        alpha += I;
    }

    for(int i=0;i<5;i++){
        float fi = float(i);
        float h1 = hash21(vec2(fi, 11.1+seed)), h2 = hash21(vec2(fi, 19.4+seed));
        float lp = fract(ph + fi/5.0 + h1*0.1);
        vec2 c = vec2((h2*2.0-1.0)*0.17, baseY + 0.05 + lp*0.5);
        float life = smoothstep(0.0, 0.2, lp)*smoothstep(1.0, 0.6, lp);
        float s = 0.022*(0.7 + 0.5*smoothstep(0.0,0.3,lp));
        vec2 d = abs(p - c);
        float arm = 0.32*s;
        float box = min(max(d.x-arm, d.y-s), max(d.x-s, d.y-arm));
        float body = smoothstep(0.003, -0.002, box);
        float halo = exp(-max(box,0.0)*60.0)*0.5;
        float I = (body + halo)*life;
        col += mix(mid, hot, body*0.8)*I;
        alpha += I;
    }

    float E = alpha;
    vec3 tint = alpha > 1e-4 ? col/alpha : mid;
    vec3 ramp = mix(vec3(0.0, 0.55, 0.18), vec3(0.2, 1.0, 0.4), smoothstep(0.1, 0.9, E));
    ramp = mix(ramp, vec3(0.85, 1.0, 0.8), smoothstep(1.0, 2.6, E));
    vec3 outc = mix(ramp, ramp*tint/max(max(tint.r,tint.g),1e-3), 0.3);
    float a = clamp(1.0 - exp(-E*1.8), 0.0, 1.0);
    fragColor = vec4(clamp(outc,0.0,1.0), a);
}
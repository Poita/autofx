// Render with:  autofx examples/gallery-opus-5-5-aaa/shock.glsl -d 0.5 -r 256x256 -f 20 -s -o examples/gallery-opus-5-5-aaa/shock.gif

float h11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
float vnoise(float x){ float i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f); return mix(h11(i),h11(i+1.0),f)*2.0-1.0; }

float sdSeg(vec2 p, vec2 a, vec2 b){
    vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/dot(ba,ba),0.0,1.0);
    return length(pa-ba*h);
}

vec2 boltPt(vec2 a, vec2 b, float seed, float amp, float s, float k){
    vec2 d = b-a; float L = length(d);
    vec2 n = vec2(-d.y,d.x)/L;
    float off = 0.0, w = 1.0, f = 2.5;
    for(int o=0;o<5;o++){ off += w*vnoise(s*f + seed*17.3 + float(o)*5.1); w*=0.5; f*=2.1; }
    float jag = h11(seed*3.1+k*7.7)*2.0-1.0;
    return a + d*s + n*L*amp*(off*0.55 + jag*0.12)*sin(1.5708*s);
}

float bolt(vec2 p, vec2 a, vec2 b, float seed, float amp, float reach, out float along){
    const float N = 22.0;
    float best = 1e3; along = 0.0;
    vec2 prev = a;
    for(int k=1;k<=22;k++){
        float s = float(k)/N;
        if(s - 1.0/N >= reach) break;
        vec2 cur = boltPt(a,b,seed,amp,s,float(k));
        if(s > reach) cur = mix(prev, cur, (reach - (s-1.0/N))*N);
        float dd = sdSeg(p, prev, cur);
        if(dd < best){ best = dd; along = s; }
        prev = cur;
    }
    return best;
}

vec3 shade(float d, float w, float I){
    return I*( vec3(1.0)*smoothstep(w, w*0.3, d)*1.5
             + vec3(0.55,0.8,1.0)*exp(-d/(w*2.2))*1.0
             + vec3(0.3,0.4,1.0)*exp(-d*30.0)*0.3 );
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float t = iTime;
    float env = smoothstep(0.0,0.025,t) * (1.0 - smoothstep(0.2,0.44,t));
    float st = floor(t*45.0);
    float flick = 0.6 + 0.4*h11(st*3.3+1.0);
    flick = mix(flick, 1.0, smoothstep(0.05,0.0,t-0.02));
    float reach = smoothstep(0.0,0.07,t);
    float shrink = 1.0 - 0.35*smoothstep(0.2,0.44,t);
    vec3 col = vec3(0.0);
    float r = length(p);
    for(int i=0;i<7;i++){
        float fi = float(i);
        float seed = st*0.37 + fi*11.0;
        float on = (t < 0.09) ? 1.0 : step(0.25, h11(seed*5.7+2.0));
        float ang = 6.2831*(fi + 0.35*(h11(fi*9.1)-0.5) + 0.3*(h11(seed)-0.5))/7.0;
        float len = (0.26 + 0.12*h11(seed*1.9+4.0))*shrink;
        vec2 dir = vec2(cos(ang),sin(ang));
        vec2 a = dir*0.025, b = dir*len;
        float s;
        float d = bolt(p, a, b, seed, 0.28, reach, s);
        float I = on*(0.7+0.3*h11(seed*2.3));
        col += shade(d, mix(0.0055,0.0025,s), I);
        for(int j=0;j<3;j++){
            float fj = float(j);
            float bs = seed*1.3 + fj*3.7 + 50.0;
            if(h11(bs) < 0.3) continue;
            float fr = 0.25 + 0.5*h11(bs+1.0);
            float kk = floor(fr*22.0);
            vec2 o = boltPt(a,b,seed,0.28,kk/22.0,kk);
            float ba = (h11(bs+2.0) > 0.5 ? 1.0 : -1.0)*(0.45+0.6*h11(bs+3.0));
            vec2 bd = vec2(dir.x*cos(ba)-dir.y*sin(ba), dir.x*sin(ba)+dir.y*cos(ba));
            vec2 e = o + bd*len*(0.2+0.25*h11(bs+4.0));
            float br = clamp((reach-fr)/(1.0-fr)*1.5,0.0,1.0);
            float sb;
            float db = bolt(p, o, e, bs, 0.35, br, sb);
            col += shade(db, mix(0.003,0.0015,sb), on*0.65);
        }
    }
    for(int i=0;i<5;i++){
        float fi=float(i);
        float seed = st*0.71 + fi*23.0 + 300.0;
        float a0 = 6.2831*h11(seed);
        float a1 = a0 + 0.8 + 1.4*h11(seed+1.0);
        float rr = 0.045 + 0.045*h11(seed+2.0);
        float s;
        float d = bolt(p, vec2(cos(a0),sin(a0))*rr, vec2(cos(a1),sin(a1))*rr, seed, 0.5, 1.0, s);
        col += shade(d, 0.0025, 0.55);
    }
    col += (exp(-r*r*1200.0)*2.2 + exp(-r*30.0)*0.7)*vec3(0.85,0.92,1.0);
    col += exp(-t*28.0)*exp(-r*r*50.0)*vec3(0.6,0.75,1.0)*1.4;
    col += exp(-r*r*22.0)*vec3(0.15,0.2,0.65)*0.4;
    col *= env*flick;
    col = 1.0 - exp(-col*1.6);
    float alpha = clamp(max(col.r,max(col.g,col.b)),0.0,1.0);
    fragColor = vec4(col, alpha);
}
// Generated by: autofx 'fiery explosion, aim for AAA quality' -f 30 -s -o examples/gallery-opus-5-5-aaa/explosion.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/explosion.glsl -d 1.0 -r 256x256 -f 30 -s -o examples/gallery-opus-5-5-aaa/explosion.gif

// Volumetric fireball: raymarched FBM sphere with blackbody emission, smoke absorption,
// an initial flash, a heat halo, a shockwave ring and ballistic sparks.
float hash31(vec3 p) {
    p = fract(p * 0.3183099 + 0.1 + iSeed * 0.013);
    p *= 17.0;
    return fract(p.x * p.y * p.z * (p.x + p.y + p.z));
}
float hash11(float n) { return fract(sin(n * 127.1 + iSeed * 3.7) * 43758.5453); }
float vnoise(vec3 x) {
    vec3 i = floor(x), f = fract(x);
    f = f * f * f * (f * (f * 6.0 - 15.0) + 10.0);
    return mix(mix(mix(hash31(i), hash31(i + vec3(1,0,0)), f.x),
                   mix(hash31(i + vec3(0,1,0)), hash31(i + vec3(1,1,0)), f.x), f.y),
               mix(mix(hash31(i + vec3(0,0,1)), hash31(i + vec3(1,0,1)), f.x),
                   mix(hash31(i + vec3(0,1,1)), hash31(i + vec3(1,1,1)), f.x), f.y), f.z);
}
float fbm(vec3 p) {
    float s = 0.0, a = 0.5;
    mat3 m = mat3(0.00, 0.80, 0.60, -0.80, 0.36, -0.48, -0.60, -0.48, 0.64);
    for (int i = 0; i < 6; i++) { s += a * vnoise(p); p = m * p * 2.03; a *= 0.5; }
    return s;
}
vec3 blackbody(float x) {
    x = clamp(x, 0.0, 1.5);
    vec3 c = vec3(0.9, 0.12, 0.02) * smoothstep(0.0, 0.3, x);
    c = mix(c, vec3(1.0, 0.45, 0.08) * 1.8, smoothstep(0.25, 0.6, x));
    c = mix(c, vec3(1.0, 0.8, 0.45) * 3.5, smoothstep(0.6, 1.0, x));
    c = mix(c, vec3(1.0, 0.97, 0.9) * 6.0, smoothstep(1.0, 1.4, x));
    return c;
}
float radiusAt(float t) { return 0.47 * (1.0 - exp(-t * 7.0)) + 0.07 * t; }
float density(vec3 q, float t, float R, out float heat) {
    float d = length(q) / R;
    vec3 np = q / R * 2.4 + vec3(t * 0.4, -t * 1.3, iSeed + t * 0.3);
    float n = fbm(np);
    // Billow noise gives cauliflower-like puffs on the surface.
    float b = 1.0 - abs(fbm(np * 1.9 + 3.1) * 2.0 - 1.0);
    float n2 = fbm(np * 3.1 + 7.0);
    float erosion = smoothstep(0.35, 1.05, t);
    // Large lobes break up the spherical silhouette.
    float lobes = fbm(q / R * 0.8 + vec3(iSeed * 1.7, 5.3, 1.1) + vec3(0.0, -t * 0.4, 0.0));
    // As it erodes, the radial falloff flattens so holes open throughout the volume.
    float shape = (1.0 - d) * (1.0 - 0.8 * erosion) + (lobes - 0.5) * 1.1 + (n - 0.5) * 1.0 + (b - 0.5) * 0.55 + (n2 - 0.5) * 0.3
                - erosion * (1.25 * n2 - 0.1)
                - smoothstep(1.1, 1.55, d);
    float core = 1.0 - smoothstep(0.0, 1.1, d);
    heat = (core * 1.5 + (n - 0.5) * 3.4 + (n2 - 0.5) * 1.4) * exp(-t * 3.4) * 1.9
         * (1.0 - smoothstep(0.4, 0.8, t));
    // Extra early heat so the young fireball reads as white-hot.
    heat += exp(-t * 9.0) * (0.9 + 0.6 * core);
    heat = max(heat, 0.0);
    return smoothstep(0.0, 0.2 + 0.35 * erosion, shape);
}
void mainImage(out vec4 fragColor, in vec2 fragCoord) {
    vec2 p = (fragCoord - 0.5 * iResolution.xy) / iResolution.y * 2.0;
    float t = iTime;
    float R = radiusAt(t);
    float fade = 1.0 - smoothstep(0.6, 0.97, t);
    vec3 col = vec3(0.0);
    float T = 1.0;
    float bound = R * 1.6;
    vec2 center = vec2(0.0, 0.12 * t * t);
    vec2 pc = p - center;
    float b2 = bound * bound - dot(pc, pc);
    if (b2 > 0.0 && fade > 0.0) {
        float zh = sqrt(b2);
        const int STEPS = 96;
        float dz = 2.0 * zh / float(STEPS);
        float jitter = hash31(vec3(fragCoord, t * 60.0));
        vec3 lightDir = normalize(vec3(-0.4, 0.7, -0.5));
        for (int i = 0; i < STEPS; i++) {
            float z = -zh + (float(i) + jitter) * dz;
            vec3 q = vec3(pc, z);
            float heat;
            float dens = density(q, t, R, heat);
            if (dens > 0.001) {
                float thin = mix(1.0, 0.45, smoothstep(0.35, 0.8, t));
                float sigma = dens * 16.0 / R * fade * thin;
                float a = 1.0 - exp(-sigma * dz);
                float hs;
                float occl = density(q + lightDir * R * 0.2, t, R, hs);
                // Smoke builds up as the fireball cools; early on it is almost pure flame.
                float smokeAmt = smoothstep(0.05, 0.35, t);
                vec3 smoke = mix(vec3(0.24, 0.2, 0.17), vec3(0.02, 0.018, 0.016), occl) * smokeAmt;
                // Hot interior underlights the surrounding smoke.
                float glow = exp(-t * 4.0) * (1.0 - smoothstep(0.3, 1.2, length(q) / R));
                smoke += vec3(0.35, 0.09, 0.015) * glow;
                vec3 c = smoke + blackbody(heat) * 1.4;
                col += T * a * c;
                T *= 1.0 - a;
                if (T < 0.004) break;
            }
        }
    }
    float fr = length(p);
    float flash = exp(-t * 20.0) * smoothstep(0.0, 0.012, t);
    float fcore = exp(-fr * fr / (0.03 + 0.3 * t)) * flash;
    col += vec3(1.0, 0.9, 0.7) * fcore * 4.0;
    float flashA = clamp(fcore * 1.5, 0.0, 1.0);
    float sr = 0.12 + t * 1.4;
    float ring = exp(-pow((fr - sr) / 0.03, 2.0)) * exp(-t * 10.0) * smoothstep(0.85, 0.7, sr);
    col += vec3(1.0, 0.55, 0.25) * ring * 0.8;
    float ringA = ring * 0.5;
    // Soft glow scattered into the surrounding air while the core is hot.
    float halo = exp(-max(length(p - vec2(0.0, 0.12 * t * t)) - R * 0.7, 0.0) * 7.0)
               * exp(-t * 6.0) * smoothstep(0.0, 0.03, t);
    col += T * vec3(1.0, 0.45, 0.12) * halo * 0.6;
    float haloA = halo * 0.45;
    // Ballistic sparks: launched fast, slowed by drag, pulled down by gravity, burn out.
    vec3 sparkCol = vec3(0.0);
    float sparkA = 0.0;
    for (int i = 0; i < 56; i++) {
        float fi = float(i);
        float ang = hash11(fi) * 6.2831853;
        float spd = 2.6 + 2.6 * hash11(fi + 13.1);
        float life = 0.3 + 0.35 * hash11(fi + 27.7);
        float t0 = 0.03 * hash11(fi + 3.3);
        float st = max(t - t0, 0.0);
        float k = 6.0;
        vec2 dir = vec2(cos(ang), sin(ang) * 0.8 + 0.15);
        float travel = (1.0 - exp(-k * st)) / k;
        vec2 pos = dir * spd * travel - vec2(0.0, 0.4 * st * st);
        vec2 vel = dir * spd * exp(-k * st) - vec2(0.0, 0.8 * st);
        float ageN = st / life;
        if (ageN > 1.0 || st <= 0.0) continue;
        vec2 tv = vel * 0.05;
        float tl = length(tv);
        vec2 tail = pos - (tl > 0.07 ? tv * (0.07 / tl) : tv);
        vec2 pa = p - tail, ba = pos - tail;
        float h = clamp(dot(pa, ba) / max(dot(ba, ba), 1e-6), 0.0, 1.0);
        float dd = length(pa - ba * h);
        float w = 0.011 * (1.0 - ageN * 0.5);
        float g = smoothstep(w, w * 0.2, dd) * (0.3 + 0.7 * h) + exp(-dd * dd / (w * w * 5.0)) * 0.3;
        float bright = (1.0 - ageN) * (1.0 - ageN * 0.5) * (0.35 + 0.65 * hash11(fi + 41.9));
        sparkCol += blackbody(0.8 - ageN * 0.5) * g * bright;
        sparkA += g * bright;
    }
    sparkA = clamp(sparkA, 0.0, 1.0);
    // Sparks fly in front of the fireball, so they composite over it.
    col = sparkCol + (1.0 - sparkA) * col;
    float volA = 1.0 - T;
    float alpha = clamp(sparkA + (1.0 - sparkA) * max(volA, max(max(flashA, haloA), ringA)), 0.0, 1.0);
    // Un-premultiply first, then tonemap the straight color so edges keep their hue.
    vec3 straight = alpha > 1e-4 ? col / alpha : vec3(0.0);
    vec3 outc = 1.0 - exp(-straight * 1.3);
    fragColor = vec4(clamp(outc, 0.0, 1.0), alpha);
}
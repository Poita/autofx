// Render with:  autofx examples/gallery-opus-5-5-aaa/ice.glsl -d 1.2 -r 256x256 -f 36 -s -o examples/gallery-opus-5-5-aaa/ice.gif

#define PI 3.14159265

float hash11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
float hash21(vec2 p){ return fract(sin(dot(p,vec2(127.1,311.7))+iSeed*7.3)*43758.5453); }
float noise(vec2 p){
    vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    return mix(mix(hash21(i),hash21(i+vec2(1,0)),f.x),mix(hash21(i+vec2(0,1)),hash21(i+vec2(1,1)),f.x),f.y);
}
float fbm(vec2 p){
    float v=0.0,a=0.5;
    for(int i=0;i<6;i++){ v+=a*noise(p); p=mat2(1.6,1.2,-1.2,1.6)*p; a*=0.5; }
    return v;
}
mat2 rot(float a){ float c=cos(a),s=sin(a); return mat2(c,-s,s,c); }

vec4 shard(vec2 p, float ang, float L, float W){
    vec2 q = rot(-ang)*p;
    float x = q.x/L;
    if(x<-0.05 || x>1.0) return vec4(0);
    float prof = W*min(max(x,0.0)/0.22,1.0)*pow(max(1.0-x,0.0),0.9);
    prof = max(prof, W*0.35*(1.0-x));
    float d = abs(q.y)-prof;
    float aa = 1.5/iResolution.y;
    float cov = 1.0-smoothstep(-aa,aa,d);
    cov *= smoothstep(-0.05,0.02,x);
    float side = q.y>0.0 ? 1.0 : 0.0;
    float across = clamp(abs(q.y)/max(prof,1e-4),0.0,1.0);
    float ridge = exp(-across*across*60.0)*(1.0-x*0.5);
    float edge = smoothstep(0.6,1.0,across);
    float shade = mix(0.35+0.4*x, 1.0-0.3*x, side);
    return vec4(cov, shade, ridge, edge);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord-0.5*iResolution.xy)/iResolution.y;
    float t = iTime;
    float r = length(p);
    float a = atan(p.y,p.x);

    vec3 deep = vec3(0.05,0.22,0.55);
    vec3 ice  = vec3(0.35,0.78,1.0);
    vec3 pale = vec3(0.80,0.95,1.0);

    vec3 col = vec3(0); float alpha = 0.0;
    float life = 1.0-smoothstep(0.75,1.15,t);

    float mistT = smoothstep(0.0,0.25,t)*(1.0-smoothstep(0.55,1.12,t));
    float mistR = 0.12+0.2*smoothstep(0.0,0.9,t);
    float n = fbm(p*6.0+vec2(0.0,-t*0.6)+fbm(p*3.0-t*0.3)*1.5);
    float mist = smoothstep(mistR,0.0,r*(0.85+0.4*n))*n*mistT;
    col += mix(deep,ice,n)*mist*0.9; alpha += mist*0.6;

    float st = clamp(t/0.55,0.0,1.0);
    float ringR = 0.38*(1.0-pow(1.0-st,3.0));
    float ringW = 0.006+0.014*st;
    float rn = fbm(vec2(a*4.0,t*2.0)+p*10.0);
    float ring = exp(-pow((r-ringR)/ringW,2.0))*(1.0-st)*smoothstep(0.0,0.05,t);
    ring *= 0.4+1.0*rn;
    col += mix(ice,pale,rn)*ring*1.2; alpha += ring*0.8;

    float grow = smoothstep(0.02,0.32,t); grow = 1.0-pow(1.0-grow,3.0);
    float crumble = smoothstep(0.62,1.05,t);
    vec3 shardCol=vec3(0); float shardA=0.0;
    for(int layer=0; layer<2; layer++){
        float NS = layer==0 ? 9.0 : 16.0;
        for(int i=0;i<16;i++){
            if(float(i)>=NS) break;
            float fi=float(i)+float(layer)*31.0;
            float ang = (float(i)+0.5*hash11(fi))/NS*2.0*PI + (layer==0?0.0:0.2);
            float L = layer==0 ? mix(0.26,0.37,hash11(fi+3.1)) : mix(0.12,0.22,hash11(fi+5.7));
            float W = layer==0 ? mix(0.03,0.045,hash11(fi+8.2)) : mix(0.015,0.025,hash11(fi+9.4));
            float delay = layer==0 ? 0.0 : 0.06;
            float g = clamp((t-delay*(1.0+hash11(fi+2.0)))/0.3,0.0,1.0); g=1.0-pow(1.0-g,3.0);
            vec2 dir = vec2(cos(ang),sin(ang));
            vec2 pp = p - dir*crumble*0.04;
            vec4 s = shard(pp, ang, L*g+1e-3, W*(0.4+0.6*g));
            if(s.x<=0.0) continue;
            float along = dot(pp,dir)/L;
            float cn = fbm(pp*28.0+fi);
            float thr = crumble*1.25 - (1.0-along)*0.35;
            float keep = smoothstep(thr-0.05,thr+0.05,cn);
            float crackEdge = (1.0-smoothstep(0.0,0.08,abs(cn-thr)))*step(0.01,crumble);
            float streak = fbm(vec2(along*8.0, dot(pp,vec2(-dir.y,dir.x))*60.0)+fi);
            vec3 c = mix(deep, ice, s.y);
            c = mix(c, pale, s.z*0.9);
            c += pale*s.w*0.5;
            c += ice*pow(streak,3.0)*0.8;
            float gl = exp(-pow((along-(t*1.6-0.1-hash11(fi+1.0)*0.2))*7.0,2.0));
            c += vec3(1.0)*gl*s.z*1.5;
            c += pale*crackEdge*1.5;
            float sa = s.x*keep*mix(0.75,0.95,s.y);
            if(layer==1) sa*=0.85;
            shardCol = shardCol*(1.0-sa)+c*sa;
            shardA = shardA+sa*(1.0-shardA);
        }
    }
    col = col*(1.0-shardA)+shardCol; alpha = alpha*(1.0-shardA)+shardA;

    vec2 hp = rot(PI/6.0)*p;
    float hexd = max(abs(hp.x)*0.866+abs(hp.y)*0.5, abs(hp.y));
    float coreS = 0.06*grow*(1.0-smoothstep(0.55,0.85,t));
    float core = 1.0-smoothstep(coreS-0.004,coreS+0.004,hexd);
    float facet = 0.5+0.5*sin(a*3.0+1.0);
    vec3 cc = mix(ice,pale,facet)*1.1;
    col = mix(col, cc, core*0.9); alpha = max(alpha, core*0.95);

    for(int i=0;i<40;i++){
        float fi=float(i);
        float ang = hash11(fi*3.3)*2.0*PI;
        float st0 = 0.62+0.25*hash11(fi*5.1);
        float lt = (t-st0)/0.35;
        if(lt<0.0||lt>1.0) continue;
        float r0 = mix(0.08,0.33,hash11(fi*7.7));
        float rr = r0 + 0.08*(1.0-pow(1.0-lt,2.0));
        vec2 c0 = vec2(cos(ang),sin(ang))*rr + vec2(0.0,-0.03*lt*lt);
        vec2 q = rot(hash11(fi)*6.28+lt*4.0*(hash11(fi*2.0)-0.5))*(p-c0);
        float sz = mix(0.006,0.014,hash11(fi*9.1))*(1.0-lt*0.6);
        float d = abs(q.x)/sz+abs(q.y)/(sz*0.55);
        float f = (1.0-smoothstep(0.85,1.0,d))*(1.0-lt);
        vec3 fc = mix(ice,pale,step(0.0,q.x));
        col = mix(col,fc,f); alpha = max(alpha,f);
    }

    for(int i=0;i<60;i++){
        float fi=float(i);
        float ang = hash11(fi*1.7+0.3)*2.0*PI;
        float spd = mix(0.15,0.42,hash11(fi*2.9));
        float t0 = 0.03+0.25*hash11(fi*4.3);
        float lt = (t-t0)/(0.55+0.35*hash11(fi*6.1));
        if(lt<0.0||lt>1.0) continue;
        float rr = spd*(1.0-pow(1.0-lt,3.0));
        vec2 c0 = vec2(cos(ang),sin(ang))*rr;
        vec2 d = p-c0;
        float tw = 0.5+0.5*sin(t*40.0+fi*3.0);
        float br = (1.0-lt)*(0.4+0.6*tw);
        float star = exp(-length(d)*220.0)*1.5
                   + exp(-abs(d.x)*700.0-abs(d.y)*90.0)*0.6
                   + exp(-abs(d.y)*700.0-abs(d.x)*90.0)*0.6;
        star*=br;
        col += vec3(0.85,0.97,1.0)*star; alpha += star*0.9;
    }

    float flash = exp(-t*14.0);
    float fl = flash*(exp(-r*r*120.0)*1.4 + exp(-r*18.0)*0.4);
    col += vec3(0.85,0.95,1.0)*fl; alpha += fl;

    float glow = exp(-r*7.0)*0.25*grow*(1.0-smoothstep(0.4,0.9,t));
    col += ice*glow; alpha += glow*0.4;

    col *= life; alpha *= life;
    alpha = clamp(alpha,0.0,1.0);
    col = col/(1.0+col*0.3);
    fragColor = vec4(col, alpha);
}
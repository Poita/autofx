// Generated by: autofx 'bubbling poison cloud, aim for AAA quality' -d 1.5 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/poison.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/poison.glsl -d 1.5 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/poison.gif

#define TAU 6.28318530718
#define DUR 1.5

float hash12(vec2 p){ vec3 p3=fract(vec3(p.xyx)*.1031); p3+=dot(p3,p3.yzx+33.33); return fract((p3.x+p3.y)*p3.z); }
vec3 hsh33(vec3 p){ p=fract(p*vec3(.1031,.1030,.0973)); p+=dot(p,p.yxz+33.33); return fract((p.xxy+p.yxx)*p.zyx); }

float gnoise(vec3 p){
    vec3 i=floor(p), f=fract(p);
    vec3 u=f*f*f*(f*(f*6.-15.)+10.);
    float a=dot(hsh33(i)*2.-1.,f);
    float b=dot(hsh33(i+vec3(1,0,0))*2.-1.,f-vec3(1,0,0));
    float c=dot(hsh33(i+vec3(0,1,0))*2.-1.,f-vec3(0,1,0));
    float d=dot(hsh33(i+vec3(1,1,0))*2.-1.,f-vec3(1,1,0));
    float e=dot(hsh33(i+vec3(0,0,1))*2.-1.,f-vec3(0,0,1));
    float g=dot(hsh33(i+vec3(1,0,1))*2.-1.,f-vec3(1,0,1));
    float h=dot(hsh33(i+vec3(0,1,1))*2.-1.,f-vec3(0,1,1));
    float k=dot(hsh33(i+vec3(1,1,1))*2.-1.,f-vec3(1,1,1));
    return mix(mix(mix(a,b,u.x),mix(c,d,u.x),u.y),mix(mix(e,g,u.x),mix(h,k,u.x),u.y),u.z);
}

float ph;
// Looping fbm: each octave's offset travels a closed circle over one period.
float fbmL(vec2 p, float rad, int oct){
    float a=ph*TAU;
    vec3 q=vec3(p,0.);
    float s=0., amp=.5;
    mat2 R=mat2(.8,.6,-.6,.8);
    for(int i=0;i<7;i++){
        if(i>=oct) break;
        float fi=float(i);
        float r=rad/(1.0+fi*0.6);
        vec3 o=vec3(cos(a+fi*1.7)*r, sin(a+fi*1.7)*r + fi*5.3, fi*3.1);
        s+=amp*gnoise(q+o);
        q.xy=R*q.xy*2.03;
        amp*=.5;
    }
    return s;
}

float smax(float a,float b,float k){ float h=clamp(0.5+0.5*(a-b)/k,0.,1.); return mix(b,a,h)+k*h*(1.-h); }

// Height field of the cloud: a cluster of bobbing spherical puffs merged smoothly.
float puffs(vec2 p){
    float a=ph*TAU;
    float H=-1.0;
    for(int i=0;i<22;i++){
        float fi=float(i);
        float h1=hash12(vec2(fi,3.1)+iSeed*0.37), h2=hash12(vec2(fi,8.7)+iSeed*0.37), h3=hash12(vec2(fi,5.5));
        float ang=fi*2.39996+h1*0.6;
        float rr=sqrt((fi+0.5)/22.0)*0.27;
        vec2 c=vec2(cos(ang),sin(ang)*0.78)*rr;
        c.y+=0.02;
        c+=0.018*vec2(sin(a+h2*TAU),cos(a+h1*TAU));
        float r=mix(0.15,0.075,rr/0.27)*(0.85+0.3*h3)*(1.0+0.07*sin(a+h3*TAU));
        float d=length(p-c);
        float s=sqrt(max(r*r-d*d,0.0))-max(d-r,0.0)*1.5;
        H=smax(H,s,0.02);
    }
    return H;
}

float heightF(vec2 p){
    vec2 w=vec2(fbmL(p*3.0+vec2(1.7,9.2),0.45,5),fbmL(p*3.0+vec2(8.3,2.8),0.45,5));
    float H=puffs(p+w*0.05);
    float n=fbmL(p*6.0+w*1.5,0.6,6);
    return H+n*0.03;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    ph=fract(iTime/DUR);
    float a=ph*TAU;

    float H=heightF(p);
    float e=1.5/iResolution.y;
    float hx=heightF(p+vec2(e,0.)), hy=heightF(p+vec2(0.,e));
    vec3 N=normalize(vec3(-(hx-H)/e,-(hy-H)/e,1.0));
    N=normalize(vec3(N.xy*0.9,N.z));

    // soft edge with eroded wisps
    float edgeN=fbmL(p*9.0+vec2(4.,1.),0.7,5);
    float cov=smoothstep(-0.03,0.05,H+edgeN*0.06);
    cov*=cov*(3.0-2.0*cov);

    vec3 Ld=normalize(vec3(-0.5,0.7,0.6));
    float dif=clamp(dot(N,Ld),0.,1.);
    float wrap=clamp((dot(N,Ld)+0.4)/1.4,0.,1.);
    float rim=pow(1.0-clamp(N.z,0.,1.),2.5);

    // self shadowing: march height toward light
    float sh=0.;
    for(int i=1;i<=6;i++){
        vec2 sp=p+Ld.xy*0.012*float(i);
        float hs=puffs(sp);
        sh+=clamp((hs-(H+Ld.z*0.012*float(i)*0.9))*14.0,0.,1.);
    }
    sh=1.0-clamp(sh/4.0,0.,0.8);

    vec3 cShadow=vec3(0.05,0.03,0.10);
    vec3 cMid=vec3(0.16,0.42,0.08);
    vec3 cLit=vec3(0.55,0.92,0.16);
    vec3 cHi=vec3(0.92,1.0,0.55);

    vec3 col=mix(cShadow,cMid,pow(wrap,1.6));
    col=mix(col,cLit,dif*sh*0.85);
    col+=cHi*pow(dif*sh,4.0)*0.55;
    col*=mix(0.45,1.2,smoothstep(-0.32,0.28,p.y-p.x*0.45));
    // subsurface: translucent glow where cloud is thin
    col+=vec3(0.25,0.85,0.12)*rim*0.45*(0.6+0.4*sh);
    // ambient occlusion in crevices
    float ao=clamp(0.55+H*4.0,0.,1.);
    col*=mix(0.55,1.0,ao);

    // pulsing toxic inner glow seeping through crevices
    float pulse=0.75+0.25*sin(a);
    float core=exp(-dot(p-vec2(0.0,0.0),p-vec2(0.0,0.0))*10.0);
    float crev=1.0-wrap;
    float veins=fbmL(p*5.0+vec2(7.,3.),0.8,5);
    veins=pow(clamp(1.0-abs(veins)*5.0,0.,1.),3.0);
    col+=vec3(0.55,1.0,0.12)*core*(crev*0.6+veins*0.5)*pulse*cov;

    // purple toxic tint near the base
    col=mix(col,col*vec3(0.75,0.6,1.1)+vec3(0.06,0.0,0.08),smoothstep(0.05,-0.28,p.y)*0.75*(1.0-dif));

    float alpha=cov;

    // translucent toxic haze hugging the cloud
    {
        float hn=fbmL(p*4.0+vec2(2.,5.),0.6,5);
        float hz=exp(min(H,0.0)*22.0)*smoothstep(-0.09,-0.05,H)*(1.0-cov);
        hz*=clamp(0.55+hn*1.4,0.,1.)*0.55;
        vec3 hc=mix(vec3(0.10,0.05,0.16),vec3(0.30,0.62,0.10),clamp(0.5+p.y*2.0+hn,0.,1.));
        col=mix(col,hc,hz/max(alpha+hz,1e-3));
        alpha=alpha+hz*(1.0-alpha);
    }
    // vapour continuously rising off the top (two crossfaded scrolling layers)
    {
        float w=0.;
        for(int L=0;L<2;L++){
            float f=fract(ph+0.5*float(L));
            float wt=1.0-abs(2.0*f-1.0);
            vec2 q=p-vec2(0.0,0.10);
            vec2 sp=vec2(q.x*4.5+0.15*sin(q.y*9.0+float(L)*2.0), q.y*2.6-f*1.2)+vec2(float(L)*13.7,0.);
            float wn=fbmL(sp,0.2,5);
            float band=exp(-q.x*q.x*16.0)*smoothstep(0.3,0.15,abs(q.x))*smoothstep(-0.02,0.1,q.y)*smoothstep(0.32,0.12,q.y);
            w+=wt*smoothstep(0.0,0.3,wn+0.12)*band;
        }
        w=clamp(w,0.,1.)*0.7*(1.0-cov);
        vec3 wc=vec3(0.30,0.68,0.12);
        col=mix(col,wc,w/max(alpha+w,1e-3));
        alpha=alpha+w*(1.0-alpha);
    }

    for(int i=0;i<18;i++){
        float fi=float(i);
        float seed=hash12(vec2(fi,7.3)+iSeed);
        float t=fract(ph*(1.0+floor(seed*1.999))+seed*3.1);
        vec2 c=vec2((hash12(vec2(fi,1.1))-0.5)*0.56,(hash12(vec2(fi,2.7))-0.5)*0.44+0.02);
        float hc=puffs(c);
        float vis=smoothstep(0.02,0.06,hc);
        if(vis<=0.0) continue;
        c+=vec2(0.008*sin(t*TAU+fi), t*0.015);
        float grow=smoothstep(0.0,0.8,t)*vis;
        float R=(0.016+0.026*hash12(vec2(fi,4.4)))*grow;
        vec2 q=p-c;
        float r=length(q);
        if(t<0.84){
            float body=smoothstep(R,R-0.003,r);
            if(body<=0.0){
                float csh=smoothstep(R*1.6,R,length(q+vec2(0.004,0.006)));
                col*=1.0-csh*0.4*grow;
                col+=vec3(0.4,0.9,0.1)*smoothstep(R*1.8,R,r)*0.25*grow;
                continue;
            }
            vec3 bn=vec3(q/max(R,1e-4),0.);
            bn.z=sqrt(max(1.0-dot(bn.xy,bn.xy),0.));
            float fres=pow(1.0-bn.z,2.0);
            float bd=clamp(dot(bn,Ld),0.,1.);
            vec3 refl=reflect(vec3(0,0,-1),bn);
            float spec=pow(clamp(dot(refl,Ld),0.,1.),40.0);
            vec3 inner=mix(vec3(0.15,0.45,0.05),vec3(0.55,1.0,0.2),0.5-0.5*bn.y);
            vec3 bcol=inner*(0.6+0.4*bd)+vec3(0.75,1.0,0.4)*fres*0.9+vec3(1.0)*spec*1.3;
            bcol=mix(bcol,col,0.25*(1.0-fres));
            col=mix(col,bcol,body);
            alpha=max(alpha,body);
        } else {
            float k=(t-0.84)/0.16;
            float Rm=(0.016+0.026*hash12(vec2(fi,4.4)))*vis;
            float pr=Rm*(1.0+k*1.6);
            float ring=smoothstep(0.005,0.0,abs(r-pr))*(1.0-k)*(1.0-k);
            float drops=0.;
            for(int j=0;j<7;j++){
                float fj=float(j);
                float an=fj*TAU/7.+hash12(vec2(fi,fj))*0.8;
                float sp=1.0+0.6*hash12(vec2(fj,fi));
                vec2 dp=c+vec2(cos(an),sin(an)*0.8)*Rm*(1.0+k*2.6*sp)+vec2(0.,-k*k*0.04);
                drops+=smoothstep(0.0055*(1.0-k)+0.001,0.0,length(p-dp))*(1.0-k*0.7);
            }
            float ee=clamp(ring+drops,0.,1.)*vis;
            col=mix(col,vec3(0.8,1.0,0.4),ee);
            alpha=max(alpha,ee);
        }
    }

    fragColor=vec4(clamp(col,0.,1.),clamp(alpha,0.,1.));
}
// Render with:  autofx examples/gallery-opus-5-5-aaa/runes.glsl -d 2.0 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/runes.gif

#define PI 3.14159265
#define TAU 6.28318531
#define LOOP 2.0
#define NRUNES 16.0

float hash11(float n){ return fract(sin(n*127.1)*43758.5453); }

mat2 rot(float a){ float c=cos(a), s=sin(a); return mat2(c,-s,s,c); }

float sdSeg(vec2 p, vec2 a, vec2 b){
    vec2 pa=p-a, ba=b-a;
    float h=clamp(dot(pa,ba)/dot(ba,ba),0.0,1.0);
    return length(pa-ba*h);
}

float angDiff(float a, float b){ return mod(a-b+PI, TAU)-PI; }

float angNoise(float a, float freq, float seed){
    float x = a/TAU*freq;
    float i = floor(x), f = fract(x);
    float h0 = hash11(mod(i,freq)+seed), h1 = hash11(mod(i+1.0,freq)+seed);
    return mix(h0,h1,f*f*(3.0-2.0*f));
}

float glyph(vec2 p, float id){
    float d = 1e5;
    float h0 = hash11(id*3.7+1.0);
    if (h0 < 0.65) d = sdSeg(p, vec2(0.0,-1.0), vec2(0.0,1.0));
    else d = min(sdSeg(p, vec2(-0.6,-1.0), vec2(-0.6,1.0)), sdSeg(p, vec2(0.6,-1.0), vec2(0.6,1.0)));
    for (int k=0;k<3;k++){
        float fk=float(k);
        float ha=hash11(id*13.1+fk*7.3), hb=hash11(id*5.9+fk*11.7+3.0);
        vec2 a = vec2(floor(ha*3.0)-1.0, floor(fract(ha*7.0)*3.0)-1.0);
        vec2 dir = vec2(hb<0.5?1.0:-1.0, fract(hb*5.0)<0.5?1.0:-1.0);
        if (fract(hb*13.0)<0.25) dir.y = 0.0;
        vec2 b = clamp(a+dir, vec2(-1.0), vec2(1.0));
        if (length(b-a)<0.5) b = vec2(-a.x, a.y - sign(a.y+0.1));
        vec2 sc = vec2(0.6,1.0);
        d = min(d, sdSeg(p, a*sc, b*sc));
    }
    if (hash11(id*2.3+9.0) > 0.7) d = min(d, abs(length(p)-0.25));
    return d;
}

vec3 lineLight(float d, float w, float glow, vec3 col){
    float core = smoothstep(w+0.0025, w, d);
    float halo = exp(-d*90.0)*0.35 + exp(-d*45.0)*0.10;
    return col*(core*1.6 + halo*glow);
}

vec3 scene(vec2 p, float t){
    float ph = fract(t/LOOP);
    float wave = sin(ph*TAU);
    vec3 gold   = vec3(1.0,0.72,0.25);
    vec3 amber  = vec3(1.0,0.45,0.08);
    vec3 white  = vec3(1.0,0.93,0.75);

    float r = length(p);
    float a = atan(p.y,p.x);

    float sweepA = ph*TAU + PI*0.5;
    float sweep = exp(-pow(angDiff(a, sweepA)/0.55,2.0));
    float sweep2 = exp(-pow(angDiff(a, sweepA+PI)/0.55,2.0));
    float shimmer = 0.75 + 0.25*sin(angNoise(a,24.0,1.0)*TAU + ph*TAU*2.0);
    float energy = (0.55 + 0.12*wave) * shimmer + 0.9*sweep + 0.5*sweep2;

    vec3 col = vec3(0.0);

    col += lineLight(abs(r-0.440), 0.0022, 1.0, gold)*energy;
    col += lineLight(abs(r-0.427), 0.0010, 0.5, amber)*energy*0.8;
    col += lineLight(abs(r-0.320), 0.0022, 1.0, gold)*energy;
    col += lineLight(abs(r-0.333), 0.0010, 0.5, amber)*energy*0.8;

    float stepA = TAU/NRUNES;
    float slot = floor(a/stepA+0.5);
    vec2 q = rot(slot*stepA)*p;
    vec2 lp = vec2(-q.y, q.x-0.380);
    float gs = 0.029;
    float id = mod(slot+NRUNES, NRUNES) + floor(iSeed*97.0)*17.0;
    float gd = glyph(lp/gs, id)*gs;
    float runeAng = slot*stepA;
    float runeSweep = exp(-pow(angDiff(runeAng, sweepA)/0.45,2.0));
    float runeSweep2 = exp(-pow(angDiff(runeAng, sweepA+PI)/0.45,2.0));
    float flick = 0.85 + 0.15*sin(ph*TAU*2.0 + hash11(id)*TAU);
    float runeE = (0.7 + 0.1*wave)*flick + 1.6*runeSweep + 0.8*runeSweep2;
    vec3 runeCol = mix(gold, white, clamp(runeSweep*0.9,0.0,1.0));
    col += lineLight(gd, 0.0024, 1.4, runeCol)*runeE;
    vec2 sq = rot((slot+0.5)*stepA)*p;
    vec2 sp = vec2(-sq.y, sq.x-0.380);
    float dia = abs(sp.x)+abs(sp.y)*0.7 - 0.005;
    col += lineLight(max(dia,0.0), 0.0008, 0.7, amber)*energy;

    float ticks = 90.0;
    float ta = a + ph*TAU*2.0/ticks;
    float tk = abs(fract(ta/TAU*ticks+0.5)-0.5)*TAU/ticks*r;
    float major = step(0.5, fract((floor(ta/TAU*ticks+0.5))/5.0 + 0.1));
    float tlen = mix(0.008, 0.004, major);
    float tickD = max(tk, abs(r-0.456)-tlen);
    col += lineLight(max(tickD,0.0), 0.0008, 0.6, gold)*energy*0.9;
    col += lineLight(abs(r-0.468), 0.0007, 0.4, amber)*energy*0.6;

    col += lineLight(abs(r-0.285), 0.0016, 0.8, gold)*energy;
    float ia = a - ph*TAU*2.0/48.0;
    float itk = abs(fract(ia/TAU*48.0+0.5)-0.5)*TAU/48.0*r;
    col += lineLight(max(max(itk, abs(r-0.297)-0.006),0.0), 0.0008, 0.5, amber)*energy;

    vec2 hp = rot(ph*TAU/6.0)*p;
    float hexD = 1e5;
    float R = 0.285;
    for (int i=0;i<6;i++){
        float a0 = float(i)*TAU/6.0 + PI*0.5;
        float a1 = a0 + TAU/3.0;
        hexD = min(hexD, sdSeg(hp, R*vec2(cos(a0),sin(a0)), R*vec2(cos(a1),sin(a1))));
    }
    col += lineLight(hexD, 0.0015, 1.0, gold)*energy*0.95;

    col += lineLight(abs(r-0.150), 0.0014, 0.8, gold)*energy;
    vec2 sp2 = rot(-ph*TAU/4.0)*p;
    float starD = 1e5;
    float R2 = 0.150;
    for (int i=0;i<8;i++){
        float a0 = float(i)*TAU/8.0;
        float a1 = a0 + TAU*3.0/8.0;
        starD = min(starD, sdSeg(sp2, R2*vec2(cos(a0),sin(a0)), R2*vec2(cos(a1),sin(a1))));
    }
    col += lineLight(starD, 0.0010, 0.7, amber)*energy*0.9;
    col += lineLight(abs(r-0.060), 0.0016, 1.0, gold)*(0.9+0.3*wave);

    float cd = glyph(p/0.032, 7.0 + floor(iSeed*97.0)*17.0)*0.032;
    col += lineLight(cd, 0.0022, 1.5, white)*(1.0+0.4*wave);

    float band = exp(-pow((r-0.380)/0.06,2.0));
    col += amber*band*0.05*energy;
    col += gold*exp(-r*r/0.004)*(0.25+0.08*wave);

    for (int i=0;i<40;i++){
        float fi=float(i);
        float h1=hash11(fi*1.31+0.7), h2=hash11(fi*2.77+3.1), h3=hash11(fi*4.13+5.3);
        float life = fract(ph*(h3<0.5?1.0:2.0) + h1);
        float ang = h2*TAU + life*(h3-0.5)*0.6;
        float rad = min(mix(0.32, 0.50, life) + (h3-0.5)*0.02, 0.50);
        vec2 pp = rad*vec2(cos(ang),sin(ang));
        float fade = smoothstep(0.0,0.15,life)*smoothstep(1.0,0.55,life);
        float dd = length(p-pp);
        col += mix(gold,white,0.4)*(exp(-dd*dd/0.000004)*1.2 + exp(-dd*dd/0.00006)*0.25)*fade;
    }
    return col;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    float t = mod(iTime, LOOP);
    vec3 acc = vec3(0.0);
    for (int sx=0; sx<3; sx++)
    for (int sy=0; sy<3; sy++){
        vec2 off = (vec2(float(sx),float(sy))-1.0)/3.0;
        vec2 p = (fragCoord+off - 0.5*iResolution.xy)/min(iResolution.x,iResolution.y)/0.90;
        acc += scene(p, t);
    }
    acc /= 9.0;
    vec3 c = 1.0 - exp(-acc*1.3);
    c = pow(c, vec3(0.95,1.0,1.1));
    float alpha = clamp(max(c.r, max(c.g, c.b)), 0.0, 1.0);
    fragColor = vec4(c, alpha);
}
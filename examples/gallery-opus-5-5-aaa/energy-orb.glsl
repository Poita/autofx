// Generated by: autofx 'glowing cyan energy orb, aim for AAA quality' -d 1.5 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/energy-orb.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/energy-orb.glsl -d 1.5 -r 256x256 -f 45 --loop -s -o examples/gallery-opus-5-5-aaa/energy-orb.gif

#define TAU 6.28318530718
#define DUR 1.5

float orbHash(vec3 p){ p = fract(p*0.1031); p += dot(p, p.yzx+33.33); return fract((p.x+p.y)*p.z); }

float orbNoise(vec3 p){
    vec3 i = floor(p), f = fract(p);
    f = f*f*f*(f*(f*6.0-15.0)+10.0);
    float n000=orbHash(i), n100=orbHash(i+vec3(1,0,0)), n010=orbHash(i+vec3(0,1,0)), n110=orbHash(i+vec3(1,1,0));
    float n001=orbHash(i+vec3(0,0,1)), n101=orbHash(i+vec3(1,0,1)), n011=orbHash(i+vec3(0,1,1)), n111=orbHash(i+vec3(1,1,1));
    return mix(mix(mix(n000,n100,f.x),mix(n010,n110,f.x),f.y),mix(mix(n001,n101,f.x),mix(n011,n111,f.x),f.y),f.z);
}

// Time enters as a point on a circle, so phase 0 and 1 sample identical noise.
float fbmLoop(vec3 p, float ph, float rad){
    vec3 off = vec3(cos(ph*TAU), sin(ph*TAU), 0.0)*rad;
    float s = 0.0, a = 0.5;
    for(int i=0;i<6;i++){
        s += a*orbNoise(p + off);
        p = p*2.03 + vec3(1.7,9.2,3.1);
        off = vec3(off.y, -off.x, off.z);
        a *= 0.5;
    }
    return s;
}

mat3 rotY(float a){ float c=cos(a), s=sin(a); return mat3(c,0,-s, 0,1,0, s,0,c); }
mat3 rotX(float a){ float c=cos(a), s=sin(a); return mat3(1,0,0, 0,c,s, 0,-s,c); }

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float ph = fract(iTime/DUR);
    float pulse = 0.5+0.5*sin(ph*TAU);
    float r = length(uv);

    float R = 0.19 + 0.008*pulse;
    vec3 col = vec3(0.0);

    // Sphere body: rotating domain-warped plasma veins with fresnel rim
    if(r < R){
        float z = sqrt(R*R - r*r);
        vec3 n = normalize(vec3(uv, z));
        vec3 sp = rotY(ph*TAU) * rotX(0.4) * n;
        float f1 = fbmLoop(sp*2.6, ph, 1.2);
        float f2 = fbmLoop(sp*2.6 + vec3(f1*2.5), ph, 0.8);
        float veins = pow(1.0 - abs(f2*2.0-1.0), 8.0);
        float fres = pow(1.0 - n.z, 2.5);
        float core = pow(n.z, 3.0);
        vec3 c = vec3(0.0, 0.25, 0.45)*(0.6+0.8*f1);
        c += vec3(0.25,0.95,1.0)*veins*(1.4+0.6*pulse);
        c += vec3(0.6,1.0,1.0)*fres*1.6;
        c += vec3(0.85,1.0,1.0)*core*(0.9+0.4*pulse)*smoothstep(0.3,0.8,f1+0.2);
        col += c*smoothstep(R, R-1.5/iResolution.y, r);
    }

    col += vec3(0.7,1.0,1.0)*exp(-r*r/(0.006+0.002*pulse))*0.9;

    // Corona flames and halo, falling to zero well inside the frame
    float d = max(r - R, 0.0);
    float bound = clamp(1.0 - r/0.47, 0.0, 1.0);
    bound *= bound;
    vec2 dir = uv/max(r,1e-4);
    float cn = fbmLoop(vec3(dir*2.2, d*6.0), ph, 1.0);
    float cn2 = fbmLoop(vec3(dir*4.5 + 3.0, d*10.0), fract(ph+0.3), 1.5);
    float flameLen = 0.012 + 0.14*cn*cn*cn + 0.012*cn2;
    float corona = exp(-d/flameLen) * smoothstep(R*0.97, R, r) * bound;
    col += vec3(0.1,0.8,1.0)*corona*(1.3+0.4*pulse);

    float halo = exp(-d*16.0)*0.45 + exp(-d*45.0)*0.8;
    col += vec3(0.05,0.55,0.9)*halo*bound*(0.85+0.3*pulse);

    // Tilted orbital rings with travelling energy streaks
    for(int k=0;k<3;k++){
        float fk = float(k);
        float tilt = fk*2.1 + 0.4;
        float ca = cos(tilt), sa = sin(tilt);
        vec2 q = mat2(ca,-sa,sa,ca)*uv;
        float ry = 0.32 + 0.025*fk;
        float rx = ry*(0.28 + 0.07*fk);
        vec2 ab = vec2(ry, rx);
        vec2 e = q/ab;
        float el = length(e);
        // First-order distance to the ellipse (value / gradient magnitude)
        float ed = abs(el-1.0) / max(length(e/(el*ab)), 1e-4);
        float th = atan(e.y, e.x);
        bool behind = e.y > 0.0 && r < R;
        float dirSign = (k==1) ? -1.0 : 1.0;
        float trav = fract(dirSign*(th/TAU - ph) - fk*0.33);
        float streak = pow(trav, 6.0) + 0.5*pow(fract(trav*2.0),10.0);
        float flick = 0.6 + 0.4*fbmLoop(vec3(cos(th)*2.0, sin(th)*2.0, fk*5.0), ph, 1.0);
        float line = exp(-ed*ed/0.000018) + exp(-ed/0.01)*0.25;
        float ringI = line*(0.15 + 1.6*streak)*flick;
        if(behind) ringI *= 0.15;
        col += vec3(0.3,0.95,1.0)*ringI;
    }

    // Orbiting sparks
    for(int i=0;i<28;i++){
        float fi = float(i);
        float h1 = orbHash(vec3(fi,1.3,7.1)), h2 = orbHash(vec3(fi,4.2,2.7)), h3 = orbHash(vec3(fi,8.8,0.3));
        float orbits = floor(1.0 + h3*2.0);
        float a = TAU*(h1 + orbits*ph*(h2>0.5?1.0:-1.0));
        float rad = 0.23 + 0.17*h2 + 0.02*sin(TAU*(ph*2.0 + h1));
        float inc = (h3-0.5)*2.4;
        vec2 p = vec2(cos(a), sin(a)*0.35*cos(inc))*rad;
        float ci = cos(h1*6.0), si = sin(h1*6.0);
        p = mat2(ci,-si,si,ci)*p;
        float bright = 0.5+0.5*sin(TAU*(ph*3.0 + h2));
        float sd = length(uv - p);
        float s = exp(-sd*sd/0.00002)*1.4 + exp(-sd/0.01)*0.12;
        float occl = (sin(a) > 0.0 && length(p) < R) ? 0.1 : 1.0;
        col += vec3(0.5,1.0,1.0)*s*bright*occl;
    }

    col = 1.0 - exp(-col*1.3);
    float alpha = clamp(max(col.r, max(col.g, col.b))*1.15, 0.0, 1.0);
    fragColor = vec4(col, alpha);
}

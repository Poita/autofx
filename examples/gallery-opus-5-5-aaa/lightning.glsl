// Render with:  autofx examples/gallery-opus-5-5-aaa/lightning.glsl -d 0.6 -r 256x256 -f 24 -s -o examples/gallery-opus-5-5-aaa/lightning.gif

#define PI 3.14159265
#define NSEG 64
#define NBR 7
#define BSEG 20
#define NSPK 28

float h11(float n){ return fract(sin(n*127.1 + iSeed*17.31)*43758.5453); }

float jag(float s, float seed){
    float v = 0.0, a = 1.0, f = 3.0;
    for(int i=0;i<6;i++){
        float x = s*f, c = floor(x);
        float r0 = h11(c + seed*31.7 + float(i)*7.3);
        float r1 = h11(c + 1.0 + seed*31.7 + float(i)*7.3);
        v += a*(mix(r0, r1, fract(x)) - 0.5);
        a *= 0.6; f *= 2.1;
    }
    return v;
}

vec2 mainP(float s){
    float x = 0.5 + 0.2*jag(s, 1.0);
    return vec2(x, mix(0.90, 0.15, s));
}

vec2 sdSeg(vec2 p, vec2 a, vec2 b){
    vec2 pa = p-a, ba = b-a;
    float h = clamp(dot(pa,ba)/dot(ba,ba), 0.0, 1.0);
    return vec2(length(pa - ba*h), h);
}

float stroke(float t, float t0, float k){ return t < t0 ? 0.0 : exp(-(t-t0)*k); }

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = fragCoord / iResolution.xy;
    float t = iTime;

    float tStrike = 0.075;
    float lead = clamp(t / tStrike, 0.0, 1.0);
    lead = 1.0 - pow(1.0 - lead, 1.6);
    float fade = 1.0 - smoothstep(0.30, 0.54, t);

    float flash = stroke(t, tStrike, 22.0)
                + 0.75*stroke(t, 0.17, 28.0)
                + 0.5*stroke(t, 0.265, 30.0)
                + 0.18*stroke(t, tStrike, 6.0);
    flash *= 0.85 + 0.15*sin(t*420.0 + iSeed);
    float leadI = (t < tStrike) ? 0.35 : 0.0;
    float mainI = (flash + leadI) * fade;
    float brI = (1.2*stroke(t, tStrike, 16.0) + 0.4*stroke(t, 0.17, 26.0) + 0.2*stroke(t,0.265,30.0) + leadI*0.9) * fade;

    vec3 col = vec3(0.0);
    vec3 cCore = vec3(1.0);
    vec3 cIn = vec3(0.62, 0.80, 1.0);
    vec3 cOut = vec3(0.38, 0.32, 1.0);

    float dMain = 1e5;
    vec2 prev = mainP(0.0);
    for(int i=1;i<=NSEG;i++){
        float s1 = float(i)/float(NSEG);
        float s0 = float(i-1)/float(NSEG);
        if(s0 > lead) break;
        vec2 cur = mainP(s1);
        vec2 b = cur;
        if(s1 > lead) b = mix(prev, cur, (lead - s0)/(s1 - s0));
        dMain = min(dMain, sdSeg(p, prev, b).x);
        prev = cur;
    }
    {
        float w = 0.0045 * (1.0 + 0.6*flash);
        float core = exp(-pow(dMain/w, 2.0));
        float inner = exp(-dMain*55.0);
        float outer = exp(-dMain*16.0);
        col += mainI * (cCore*core*1.6 + cIn*inner*0.9 + cOut*outer*0.4);
        if(t < tStrike){
            vec2 tip = mainP(lead);
            float dt = length(p - tip);
            col += (cCore*exp(-dt*90.0)*1.2 + cIn*exp(-dt*25.0)*0.5);
        }
    }

    for(int b=0;b<NBR;b++){
        float fb = float(b);
        float s0 = 0.06 + 0.72*(fb + 0.3 + 0.4*h11(fb*13.1+5.0))/float(NBR);
        if(lead < s0) continue;
        vec2 o = mainP(s0);
        float side = (mod(fb,2.0) < 0.5) ? 1.0 : -1.0;
        if(h11(fb*3.7+2.0) > 0.7) side = -side;
        if(o.x > 0.6) side = -1.0;
        if(o.x < 0.4) side = 1.0;
        vec2 dir = normalize(vec2(side*(0.6+0.9*h11(fb*9.1+1.0)), -1.0));
        vec2 nrm = vec2(-dir.y, dir.x);
        float len = (0.13 + 0.17*h11(fb*4.3+8.0)) * (1.0 - 0.55*s0);
        float bp = clamp((lead - s0)/(1.0 - s0)*1.8, 0.0, 1.0);
        float db = 1e5, ub = 0.0;
        vec2 pv = o;
        for(int i=1;i<=BSEG;i++){
            float u1 = float(i)/float(BSEG), u0 = float(i-1)/float(BSEG);
            if(u0 > bp) break;
            vec2 cu = o + dir*len*u1 + nrm*len*0.5*jag(u1, 10.0+fb)*u1;
            vec2 e = cu;
            if(u1 > bp){ e = mix(pv, cu, (bp-u0)/(u1-u0)); }
            vec2 r = sdSeg(p, pv, e);
            if(r.x < db){ db = r.x; ub = mix(u0,u1,r.y); }
            pv = cu;
        }
        float taper = pow(1.0 - ub, 1.1);
        float w = 0.0034 * (0.35 + 0.65*taper);
        float core = exp(-pow(db/w, 2.0));
        float inner = exp(-db*65.0);
        float outer = exp(-db*22.0);
        col += brI * taper * (cCore*core*1.3 + cIn*inner*0.6 + cOut*outer*0.18);
    }

    vec2 imp = mainP(1.0);
    float impI = (stroke(t, tStrike, 14.0) + 0.6*stroke(t,0.17,22.0) + 0.4*stroke(t,0.265,24.0)) * fade;
    {
        vec2 q = (p - imp) * vec2(1.0, 2.6);
        float d = length(q);
        col += impI * (cCore*exp(-d*60.0)*1.2 + cIn*exp(-d*20.0)*0.7 + cOut*exp(-d*9.0)*0.3);
        float ta = t - tStrike;
        if(ta > 0.0){
            float rad = 0.02 + ta*0.45;
            float ring = exp(-pow((d - rad)*70.0, 2.0));
            col += cIn * ring * 0.8 * exp(-ta*9.0) * fade;
        }
    }

    for(int i=0;i<NSPK;i++){
        float fi = float(i);
        float t0 = tStrike + ((mod(fi,3.0) < 0.5) ? 0.095 : 0.0) + 0.01*h11(fi*2.1);
        float life = 0.18 + 0.2*h11(fi*5.3+1.0);
        float ta = t - t0;
        if(ta < 0.0 || ta > life) continue;
        float ang = PI*0.5 + (h11(fi*7.7+3.0)-0.5)*PI*0.9;
        float sp = 0.25 + 0.55*h11(fi*1.9+4.0);
        vec2 v = vec2(cos(ang), sin(ang))*sp*vec2(1.0, 0.8);
        vec2 g = vec2(0.0, -2.2);
        vec2 pa = imp + v*ta + 0.5*g*ta*ta;
        float tb = max(ta - 0.025, 0.0);
        vec2 pb = imp + v*tb + 0.5*g*tb*tb;
        float d = sdSeg(p, pa, pb).x;
        float k = 1.0 - ta/life;
        vec3 sc = mix(vec3(0.5,0.65,1.0), vec3(1.0), k*k);
        col += sc * (exp(-pow(d/0.0025,2.0))*1.3 + exp(-d*90.0)*0.35) * k * fade;
    }

    col = 1.0 - exp(-col*1.4);
    float a = clamp(max(col.r, max(col.g, col.b)), 0.0, 1.0);
    a = clamp((a - 0.004)/0.996, 0.0, 1.0);
    vec3 rgb = a > 0.0 ? col / max(a, 1e-4) : vec3(0.0);
    fragColor = vec4(clamp(rgb, 0.0, 1.0), a);
}
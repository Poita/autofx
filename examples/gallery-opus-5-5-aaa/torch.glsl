// Generated by: autofx 'torch flame, aim for AAA quality' -f 30 --loop -s -o examples/gallery-opus-5-5-aaa/torch.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/torch.glsl -d 1.0 -r 256x256 -f 30 --loop -s -o examples/gallery-opus-5-5-aaa/torch.gif

#define TAU 6.28318530718

float hash31(vec3 p){ p = fract(p*0.1031); p += dot(p, p.zyx+31.32); return fract((p.x+p.y)*p.z); }
float hash21(vec2 p){ return hash31(vec3(p, 7.13)); }

float vnoise(vec3 p){
    vec3 i = floor(p), f = fract(p);
    vec3 u = f*f*f*(f*(f*6.0-15.0)+10.0);
    float a = hash31(i), b = hash31(i+vec3(1,0,0)), c = hash31(i+vec3(0,1,0)), d = hash31(i+vec3(1,1,0));
    float e = hash31(i+vec3(0,0,1)), g = hash31(i+vec3(1,0,1)), h = hash31(i+vec3(0,1,1)), k = hash31(i+vec3(1,1,1));
    return mix(mix(mix(a,b,u.x),mix(c,d,u.x),u.y), mix(mix(e,g,u.x),mix(h,k,u.x),u.y), u.z);
}

// Upward-scrolling FBM; the z slice moves on a closed path so the loop is seamless
float fbm(vec2 p, float scroll, float t){
    float s = 0.0, a = 0.5;
    vec3 q = vec3(p.x, p.y - scroll, 0.6*cos(TAU*t));
    for(int i=0;i<6;i++){
        s += a * vnoise(q);
        q = q*2.03 + vec3(1.7, -scroll*0.7, 3.1);
        a *= 0.5;
    }
    return s;
}

// Two half-period-offset scrolling layers cross-faded so the fract() wrap is invisible
float loopFbm(vec2 p, float t, float speed){
    float f1 = fract(t), f2 = fract(t + 0.5);
    float w1 = 1.0 - abs(2.0*f1 - 1.0);
    float w2 = 1.0 - w1;
    float n = fbm(p, f1*speed, t)*w1 + fbm(p + vec2(13.7, 4.1), f2*speed, t)*w2;
    return (n - 0.5)/sqrt(w1*w1 + w2*w2) + 0.5;
}

// Blackbody-style ramp: deep red -> orange -> yellow -> pale core
vec3 fireColor(float x){
    x = clamp(x, 0.0, 1.5);
    vec3 c = vec3(0.25, 0.02, 0.0);
    c = mix(c, vec3(0.75, 0.10, 0.01), smoothstep(0.0, 0.25, x));
    c = mix(c, vec3(1.0, 0.36, 0.04), smoothstep(0.2, 0.5, x));
    c = mix(c, vec3(1.0, 0.62, 0.15), smoothstep(0.45, 0.75, x));
    c = mix(c, vec3(1.0, 0.85, 0.45), smoothstep(0.7, 1.0, x));
    c = mix(c, vec3(1.0, 0.97, 0.85), smoothstep(0.95, 1.35, x));
    return c * (0.6 + 0.9*smoothstep(0.0, 1.0, x));
}

float sdSeg(vec2 p, vec2 a, vec2 b){
    vec2 pa=p-a, ba=b-a; float h=clamp(dot(pa,ba)/dot(ba,ba),0.,1.); return length(pa-ba*h);
}

// Premultiplied "over" compositing
void over(inout vec4 dst, vec3 c, float a){ dst.rgb = c*a + dst.rgb*(1.0-a); dst.a = a + dst.a*(1.0-a); }

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = (fragCoord - 0.5*iResolution.xy) / iResolution.y;
    float t = fract(iTime);
    float ph = TAU*t;
    float flick = 0.92 + 0.05*sin(ph*3.0) + 0.04*sin(ph*5.0 + 1.0) + 0.03*sin(ph*7.0+2.0);

    vec4 acc = vec4(0.0);
    vec2 base = vec2(0.0, -0.17);   // top of the torch head

    // Soft outer glow
    {
        vec2 gp = (uv - vec2(0.0, -0.02)) * vec2(1.25, 0.85);
        float g = exp(-dot(gp,gp)*45.0) * 0.22 * flick;
        over(acc, vec3(1.0, 0.45, 0.1), clamp(g,0.0,1.0));
    }

    // Wooden handle
    {
        vec2 p = uv - vec2(0.0, -0.335);
        float hw = mix(0.020, 0.030, smoothstep(-0.12, 0.12, p.y));
        float d = max(abs(p.x) - hw, abs(p.y) - 0.115);
        d = min(d, length(vec2(p.x, p.y+0.115)) - hw);
        float m = smoothstep(0.003, -0.002, d);
        float grain = vnoise(vec3(p.x*70.0, p.y*5.0, 1.0))*0.6 + vnoise(vec3(p.x*180.0, p.y*18.0, 2.0))*0.4;
        float xs = clamp(p.x/hw, -1.0, 1.0);
        float shade = 0.35 + 0.65*sqrt(max(0.0, 1.0 - xs*xs));
        vec3 wood = mix(vec3(0.13,0.065,0.03), vec3(0.34,0.19,0.09), grain) * shade;
        float lit = exp(-(0.115 - p.y)*9.0);
        wood += vec3(0.7,0.28,0.06)*lit*0.45*shade*flick;
        wood += vec3(1.0,0.5,0.15)*0.25*smoothstep(0.3,0.95,xs)*lit; // rim light
        over(acc, wood, m);
    }

    // Wrapped, pitch-soaked head with glowing embers
    {
        vec2 p = uv - vec2(0.0, -0.215);
        float w = 0.048 + 0.006*smoothstep(-0.05, 0.03, p.y);
        float d = max(abs(p.x) - w, abs(p.y) - 0.048);
        float m = smoothstep(0.003, -0.002, d - 0.004*vnoise(vec3(p*120.0, 4.0)));
        float xs = clamp(p.x/w, -1.0, 1.0);
        float shade = 0.3 + 0.7*sqrt(max(0.0, 1.0 - xs*xs));
        float bands = smoothstep(0.2, 0.8, sin((p.y + p.x*0.4 + 0.03*xs*xs)*150.0)*0.5+0.5);
        float nn = vnoise(vec3(p*90.0, 3.0));
        vec3 cloth = mix(vec3(0.05,0.035,0.025), vec3(0.20,0.13,0.08), bands*0.7+nn*0.3) * shade;
        float emb = vnoise(vec3(p*60.0, 5.0 + 0.7*cos(ph))) * vnoise(vec3(p*35.0 + 9.0, 1.0 + 0.7*sin(ph)));
        float hot = smoothstep(0.2, 0.42, emb) * (0.4 + 0.6*smoothstep(-0.05, 0.04, p.y)) * (1.0-bands*0.5);
        cloth += vec3(1.0,0.32,0.04)*hot*1.3;
        cloth += vec3(1.0,0.45,0.1)*smoothstep(0.0,0.05,p.y)*0.5*shade*flick;
        over(acc, cloth, m);
    }

    // Flame
    {
        vec2 fp = uv - base;
        float h = fp.y;
        float sway = 0.022*sin(ph) + 0.01*sin(2.0*ph + 1.3);
        fp.x -= sway * smoothstep(0.0, 0.5, h) * h * 2.5;

        float n  = loopFbm(fp*vec2(9.0, 5.0), iTime, 4.0);
        float n2 = loopFbm(fp*vec2(18.0, 10.0) + 5.3, iTime, 7.0);

        // domain warp grows with height so the top breaks into licking tongues
        float hk = smoothstep(0.0, 0.35, h);
        vec2 q = fp;
        q.x += (n - 0.5)*0.14*hk + (n2-0.5)*0.035*(0.3+hk);
        q.y += (n2 - 0.5)*0.04;

        float H = 0.44 * (0.95 + 0.05*sin(ph*2.0));
        float hn = clamp(q.y / H, 0.0, 1.0);
        float width = 0.115 * pow(1.0 - hn, 0.65) * (0.75 + 0.5*smoothstep(-0.02, 0.06, q.y));
        float bot = smoothstep(-0.04, 0.02, q.y);
        float body = 1.0 - abs(q.x)/max(width, 1e-3);
        body += (n2 - 0.5) * 0.3;
        body -= smoothstep(0.25, 0.75, 1.0 - n) * 1.2 * hk;
        body *= bot * step(q.y, H);
        float flame = clamp(body*1.6, 0.0, 1.0);

        float cw = 0.045 * (1.0 - smoothstep(0.0, 0.22, q.y)) + 0.004;
        float core = exp(-pow(q.x/cw, 2.0)) * smoothstep(-0.03, 0.02, q.y) * (1.0 - smoothstep(0.05, 0.22, q.y));
        float temp = flame * (0.45 + 0.4*(1.0 - hn)) + core*0.5*flame;
        temp *= flick;

        float wisp = smoothstep(0.66, 0.85, n*0.8 + n2*0.5 - abs(q.x)*5.0 - (q.y-0.3)*0.8) * smoothstep(0.22, 0.32, q.y) * (1.0 - smoothstep(0.38, 0.46, q.y));
        temp = max(temp, wisp*0.45);

        vec3 fcol = fireColor(temp*1.05);
        // faint blue at the base where fuel meets air
        float blue = smoothstep(0.025, -0.01, q.y) * smoothstep(0.0, 0.3, flame) * smoothstep(0.03, 0.06, abs(q.x));
        fcol = mix(fcol, vec3(0.3, 0.45, 1.0), blue*0.4);
        float fa = clamp(smoothstep(0.0, 0.35, temp), 0.0, 1.0);
        acc.rgb = acc.rgb*(1.0 - fa*0.7) + fcol*fa;
        acc.a = fa + acc.a*(1.0 - fa);
    }

    // Rising embers; integer life rates keep the loop seamless
    for(int i=0;i<26;i++){
        float fi = float(i);
        float r1 = hash21(vec2(fi, 1.3)), r2 = hash21(vec2(fi, 7.7)), r3 = hash21(vec2(fi, 3.1));
        float life = fract(t*(r2 > 0.5 ? 1.0 : 2.0) + r1);
        float y = base.y + 0.05 + life * (0.22 + 0.16*r2);
        float wob = sin(life*7.0 + fi*2.1);
        float x = (r3 - 0.5)*0.08 + wob*0.025*life + (r3-0.5)*0.14*life*life;
        vec2 sp = vec2(x, y);
        vec2 tail = vec2(-cos(life*7.0 + fi*2.1)*0.006, -0.014);
        float d = sdSeg(uv, sp, sp + tail);
        float fade = smoothstep(0.0, 0.15, life) * (1.0 - smoothstep(0.45, 1.0, life));
        float sz = 0.0018 + 0.0016*r3;
        float s = smoothstep(sz*1.5, 0.0, d) * fade;
        float sg = exp(-d*d/(sz*sz*14.0)) * fade * 0.4;
        vec3 sc = mix(vec3(1.0, 0.9, 0.55), vec3(1.0, 0.35, 0.05), life);
        float a = clamp(s + sg, 0.0, 1.0);
        acc.rgb += sc * (s*1.6 + sg);
        acc.a = a + acc.a*(1.0 - a);
    }

    vec3 col = acc.rgb / max(acc.a, 1e-4);   // un-premultiply for straight alpha
    col = 1.0 - exp(-col*1.7);
    fragColor = vec4(col, clamp(acc.a, 0.0, 1.0));
}

// Generated by: autofx 'expanding shockwave ring, aim for AAA quality' -d 0.6 -f 24 -s -o examples/gallery-opus-5-5-aaa/shockwave.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/shockwave.glsl -d 0.6 -r 256x256 -f 24 -s -o examples/gallery-opus-5-5-aaa/shockwave.gif

float hash(vec2 p){ p = fract(p*vec2(123.34, 456.21)); p += dot(p, p+45.32); return fract(p.x*p.y); }
float noise(vec2 p){
    vec2 i=floor(p), f=fract(p); f=f*f*(3.0-2.0*f);
    return mix(mix(hash(i),hash(i+vec2(1,0)),f.x), mix(hash(i+vec2(0,1)),hash(i+vec2(1,1)),f.x), f.y);
}
float fbm(vec2 p){ float v=0.0,a=0.5; for(int i=0;i<6;i++){ v+=a*noise(p); p=p*2.03+vec2(1.7,9.2); a*=0.5;} return v; }

// Seamless angular noise sampled on a circle
float angNoise(float ang, float freq, float off){
    return fbm(vec2(cos(ang), sin(ang)) * freq + off);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy) / iResolution.y;
    float t = clamp(iTime / 0.6, 0.0, 1.0);
    float seed = iSeed * 17.31;
    float r = length(p);
    float ang = atan(p.y, p.x);

    float life = smoothstep(0.0, 0.05, t) * pow(1.0 - t, 1.1) * (1.0 - smoothstep(0.8, 0.97, t));

    // Ease-out expansion
    float R = 0.40 * (1.0 - pow(1.0 - t, 3.0));
    float n1 = angNoise(ang, 3.0, seed + t*2.0);
    float n2 = angNoise(ang, 10.0, seed + 5.0 - t*3.0);
    float rd = r + (n1 - 0.5) * 0.025 * t + (n2 - 0.5) * 0.008 * t;

    float thick = mix(0.010, 0.035, t);
    float d = rd - R;

    // Sharp leading front, short soft wake behind it
    float lead  = exp(-pow(max(d, 0.0) / (thick*0.3), 2.0));
    float trail = exp(-pow(max(-d, 0.0) / (thick*1.3), 1.6));
    float ring  = d > 0.0 ? lead : trail;
    float core  = exp(-pow(d / (thick*0.22), 2.0));

    // Radial streak breakup of the wake as it decays
    float streak = fbm(vec2(ang * 40.0 / 6.2831, rd * 14.0 - t * 5.0) + seed);
    float breakupAmt = smoothstep(0.05, 0.6, t);
    ring *= mix(1.0, smoothstep(0.3, 0.75, streak) * 1.7, breakupAmt);
    core *= mix(1.0, 0.55 + 0.6*smoothstep(0.25, 0.7, streak), breakupAmt);

    // Trailing secondary ring
    float t2 = clamp((t - 0.1) / 0.9, 0.0, 1.0);
    float R2 = 0.29 * (1.0 - pow(1.0 - t2, 2.6));
    float ring2 = exp(-pow((rd - R2) / (0.006 + 0.015*t), 2.0)) * 0.4 * smoothstep(0.1, 0.25, t)
                * (0.5 + 0.8*smoothstep(0.3, 0.7, streak));

    // Detonation flash
    float flash = exp(-r*r / (0.0015 + 0.02*t)) * exp(-t * 18.0) * 3.0;

    // Radial sparks riding with the front
    float sparks = 0.0;
    for(int i=0;i<36;i++){
        float fi = float(i);
        float a0 = hash(vec2(fi, seed+1.0)) * 6.2831;
        float sp = 0.8 + 0.35*hash(vec2(fi, seed+2.0));
        float sr = R * sp;
        float len = (0.02 + 0.05*hash(vec2(fi, seed+3.0))) * (1.0 - t);
        float da = abs(mod(ang - a0 + 3.14159, 6.2831) - 3.14159) * r;
        float along = r - sr;
        float s = exp(-da*da / 0.000008) * smoothstep(-len, 0.0, along) * (1.0 - smoothstep(0.0, 0.004, along));
        sparks += s * (0.5 + 0.5*hash(vec2(fi, seed+4.0)));
    }
    sparks *= smoothstep(0.03, 0.1, t);

    // Faint distorted-air haze inside the ring
    float haze = smoothstep(R, R*0.2, r) * smoothstep(0.35, 0.8, fbm(p*12.0 + seed + t*3.0)) * 0.05 * smoothstep(0.0, 0.15, t);

    float E = (ring * 0.95 + core * 2.0 + ring2 + sparks * 1.5 + haze) * life + flash;

    // Chromatic fringes: cool outside the front, warm inside
    float fringeB = exp(-pow((d - thick*0.35) / (thick*0.3), 2.0)) * life * 0.7;
    float fringeR = exp(-pow((d + thick*0.7) / (thick*0.5), 2.0)) * life * 0.35 * (1.0 - t);

    vec3 col = mix(vec3(0.10, 0.28, 1.0), vec3(0.35, 0.85, 1.0), smoothstep(0.0, 0.5, E));
    col = mix(col, vec3(1.0), smoothstep(0.7, 1.6, E));
    col *= E;
    col += vec3(0.15, 0.45, 1.0) * fringeB;
    col += vec3(1.0, 0.55, 0.3) * fringeR;

    col = 1.0 - exp(-col * 1.8);
    float a = clamp(pow(max(max(col.r, col.g), col.b), 0.8), 0.0, 1.0);
    if (t >= 1.0) a = 0.0;
    fragColor = vec4(a > 0.0 ? col / a : vec3(0.0), a);
}
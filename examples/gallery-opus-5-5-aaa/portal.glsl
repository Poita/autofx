// Generated by: autofx 'swirling purple magic portal, aim for AAA quality' -d 2.0 -f 60 --loop -s -o examples/gallery-opus-5-5-aaa/portal.gif
// Render with:  autofx examples/gallery-opus-5-5-aaa/portal.glsl -d 2.0 -r 256x256 -f 60 --loop -s -o examples/gallery-opus-5-5-aaa/portal.gif

#define TAU 6.28318530718
#define DUR 2.0

float hash(vec3 p){ p=fract(p*0.3183099+0.1); p*=17.0; return fract(p.x*p.y*p.z*(p.x+p.y+p.z)); }
float noise(vec3 x){
    vec3 i=floor(x), f=fract(x); f=f*f*(3.0-2.0*f);
    return mix(mix(mix(hash(i),hash(i+vec3(1,0,0)),f.x),mix(hash(i+vec3(0,1,0)),hash(i+vec3(1,1,0)),f.x),f.y),
               mix(mix(hash(i+vec3(0,0,1)),hash(i+vec3(1,0,1)),f.x),mix(hash(i+vec3(0,1,1)),hash(i+vec3(1,1,1)),f.x),f.y),f.z);
}
float fbm(vec3 p){
    float v=0.0,a=0.5;
    for(int i=0;i<6;i++){ v+=a*noise(p); p=p*2.03+vec3(1.7,9.2,3.1); a*=0.5; }
    return v;
}

// Angle is sampled on a circle so it stays periodic; radial depth flows inward and is
// crossfaded between two phase-offset layers so the flow loops seamlessly.
float swirlLayer(float ang, float depth, float seed){
    vec2 c = vec2(cos(ang), sin(ang));
    vec3 p = vec3(c*1.6, depth*2.2 + seed);
    vec3 q = vec3(fbm(p), fbm(p+vec3(5.2,1.3,2.8)), 0.0);
    return fbm(p + 1.4*q);
}
float flowNoise(float ang, float r, float ph, float seed){
    float d = -log(max(r,1e-3));
    float p1 = fract(ph), p2 = fract(ph+0.5);
    float w1 = 1.0-abs(2.0*p1-1.0);
    float w2 = 1.0-abs(2.0*p2-1.0);
    float a = swirlLayer(ang, d + p1*1.5, seed);
    float b = swirlLayer(ang, d + p2*1.5, seed+7.3);
    return (a*w1 + b*w2)/(w1+w2);
}

vec3 portalColor(float x){
    vec3 c0=vec3(0.03,0.0,0.08), c1=vec3(0.18,0.0,0.42), c2=vec3(0.52,0.06,0.95), c3=vec3(0.88,0.42,1.0), c4=vec3(1.0,0.92,1.0);
    x=clamp(x,0.0,1.0);
    if(x<0.25) return mix(c0,c1,x/0.25);
    if(x<0.55) return mix(c1,c2,(x-0.25)/0.3);
    if(x<0.82) return mix(c2,c3,(x-0.55)/0.27);
    return mix(c3,c4,(x-0.82)/0.18);
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 uv = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float ph = fract(iTime/DUR);
    float rot = ph*TAU;
    float pulse = 0.5+0.5*sin(rot);

    uv *= 1.0 + 0.012*sin(rot*2.0 + atan(uv.y,uv.x)*3.0);
    float r = length(uv);
    float a = atan(uv.y, uv.x);

    float R = 0.31;
    float rn = r / R;

    // interior swirl: twist grows toward the center, field turns once per loop
    float twist = 2.4/(rn+0.25);
    float n  = flowNoise(a + twist + rot, rn, ph, iSeed*13.1);
    float n2 = flowNoise(-a + twist*1.3 - rot*2.0, rn, ph+0.33, 3.7+iSeed);

    float arms = 0.5+0.5*sin(3.0*a - 6.0*log(rn+0.05) + rot - n*4.0);
    arms = pow(arms, 4.0);

    float edgeN = (n-0.5)*0.12;
    float inside = smoothstep(1.0, 0.93, rn + edgeN);
    float depthFade = smoothstep(0.0, 0.95, rn);

    float interior = n*0.85 + arms*0.5*depthFade + n2*0.3;
    interior = pow(clamp(interior-0.25,0.0,2.0), 1.5)*1.6;
    interior *= mix(0.25, 1.0, depthFade);
    // thin bright energy filaments
    float fil = exp(-abs(n2-0.55)*60.0) * depthFade;
    vec3 col = portalColor(interior) * inside;
    col += vec3(0.95,0.7,1.0)*fil*0.8*inside;

    // dark vortex eye with bright core glint
    float eye = smoothstep(0.4, 0.0, rn);
    col *= 1.0 - 0.8*eye;
    col += vec3(0.85,0.55,1.0) * exp(-rn*rn*120.0) * (0.7+0.5*pulse);

    // energy rim
    float rimN = flowNoise(a + rot*2.0, 1.0, ph*2.0, 11.0+iSeed);
    float rimR = 1.0 + (rimN-0.5)*0.08 + edgeN*0.3;
    float dr = rn - rimR;
    float rim = exp(-dr*dr*1400.0) * (0.7 + 0.8*rimN);
    float rimGlow = exp(-abs(dr)*10.0) * (0.55 + 0.3*pulse);
    col += vec3(1.0,0.88,1.0)*rim*1.5;
    col += vec3(0.55,0.15,1.0)*rimGlow;

    // wispy tendrils curling outward around the rim
    float outer = max(rn-1.0, 0.0);
    float wisps = flowNoise(a - 1.5/(rn+0.2) - rot, rn*0.7, -ph, 21.0+iSeed);
    float w = smoothstep(0.5, 0.85, wisps) * exp(-outer*6.0) * step(1.0, rn);
    col += vec3(0.6,0.2,1.0)*w*1.3;

    // orbiting sparks with tapered arc trails; integer orbit counts per loop
    for(int i=0;i<32;i++){
        float fi=float(i);
        float h1=fract(sin(fi*12.9898+iSeed)*43758.5453);
        float h2=fract(sin(fi*78.233+iSeed)*12345.678);
        float h3=fract(sin(fi*39.425)*24634.6345);
        float speed = h3<0.5 ? 1.0 : 2.0;
        float pa = h2*TAU + rot*speed;
        float pr = R*(1.04 + 0.32*h1 + 0.05*sin(rot*2.0+fi));
        float tw = 0.5+0.5*sin(rot*3.0+fi*2.1);
        float trailLen = 0.35*speed;
        float behind = mod(pa - a, TAU);              // angle behind the head
        float s = clamp(behind, 0.0, trailLen);
        float ca = pa - s;
        float d = length(uv - pr*vec2(cos(ca), sin(ca)));
        float taper = 1.0 - s/trailLen;
        col += vec3(0.8,0.45,1.0) * 0.00003/(d*d+0.00003) * tw * taper*taper;
        vec2 head = pr*vec2(cos(pa), sin(pa));
        float hd = length(uv-head);
        col += vec3(1.0,0.95,1.0) * (exp(-hd*hd*50000.0) + 0.00002/(hd*hd+0.00004)) * tw;
    }

    // soft outer halo
    col += vec3(0.4,0.1,0.85) * exp(-outer*5.0) * 0.3 * step(1.0,rn);

    col = 1.0 - exp(-col*1.5);
    float alpha = clamp(max(max(col.r,col.g),col.b)*1.4, 0.0, 1.0);
    alpha = max(alpha, inside);
    float bound = smoothstep(0.49, 0.38, r);
    alpha *= bound;
    // straight (non-premultiplied) color for glow regions
    float m = max(max(col.r,col.g),col.b);
    vec3 outc = col / max(m, 1e-3) * min(1.0, m*1.6);
    col = mix(outc, col, inside);
    fragColor = vec4(col, alpha);
}

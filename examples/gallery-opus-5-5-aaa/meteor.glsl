// Render with:  autofx examples/gallery-opus-5-5-aaa/meteor.glsl -d 0.8 -r 256x256 -f 30 -s -o examples/gallery-opus-5-5-aaa/meteor.gif

const float T_IMPACT = 0.42;
const vec2 P0 = vec2(0.36, 0.40);
const vec2 P1 = vec2(-0.14, -0.26);

float hash11(float n){ return fract(sin(n*127.1+iSeed*13.7)*43758.5453); }
vec2 hash21(float n){ return fract(sin(vec2(n*127.1+iSeed, n*311.7+iSeed*1.3))*vec2(43758.5453,22578.1459)); }
float hash2(vec2 p){ p=fract(p*vec2(123.34,456.21)); p+=dot(p,p+45.32+iSeed); return fract(p.x*p.y); }
float noise(vec2 p){
    vec2 i=floor(p), f=fract(p); f=f*f*f*(f*(f*6.-15.)+10.);
    return mix(mix(hash2(i),hash2(i+vec2(1,0)),f.x),mix(hash2(i+vec2(0,1)),hash2(i+vec2(1,1)),f.x),f.y);
}
float fbm(vec2 p){
    float a=0.5, s=0.;
    mat2 r=mat2(0.8,0.6,-0.6,0.8);
    for(int i=0;i<6;i++){ s+=a*noise(p); p=r*p*2.03+1.7; a*=0.5; }
    return s;
}
vec3 fireRamp(float x){
    x=clamp(x,0.,1.);
    vec3 c=mix(vec3(0.35,0.03,0.0),vec3(1.0,0.25,0.02),smoothstep(0.0,0.3,x));
    c=mix(c,vec3(1.0,0.62,0.15),smoothstep(0.25,0.55,x));
    c=mix(c,vec3(1.0,0.92,0.65),smoothstep(0.5,0.8,x));
    c=mix(c,vec3(0.9,0.95,1.0),smoothstep(0.8,1.0,x));
    return c;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p=(fragCoord-0.5*iResolution.xy)/iResolution.y;
    float t=iTime;
    vec2 dir=normalize(P1-P0);
    vec2 nrm=vec2(-dir.y,dir.x);
    float pathLen=length(P1-P0);
    float speed=pathLen/T_IMPACT;
    float tf=min(t,T_IMPACT);
    float sHead=pathLen*(0.75*tf/T_IMPACT+0.25*pow(tf/T_IMPACT,2.0));
    vec2 head=P0+dir*sHead;
    float flying=step(t,T_IMPACT);
    float fadeIn=smoothstep(0.0,0.06,t);
    vec3 col=vec3(0); float alpha=0.;
    vec3 smokeCol=vec3(0); float smokeA=0.;
    vec2 rel=p-P0;
    float sAlong=dot(rel,dir);
    float perp=dot(rel,nrm);
    if(sAlong>-0.05 && sAlong<sHead+0.05){
        float sc=clamp(sAlong,0.,sHead);
        float u=sc/pathLen;
        float x=(-0.75+sqrt(0.5625+u))/0.5;
        float te=x*T_IMPACT;
        float age=max(t-te,0.);
        float behind=sHead-sc;
        float n1=fbm(vec2(sAlong*9.0-t*3.0, perp*14.0+te*5.0));
        float n2=fbm(vec2(sAlong*22.0+t*1.5, perp*30.0-t*4.0)+n1*2.0);
        float width=0.008+age*0.11+behind*0.05;
        float wob=(n1-0.5)*age*0.12;
        float d=abs(perp-wob)/width;
        float core=exp(-d*d*2.2);
        float lifeHot=exp(-age*5.5);
        float shape=core*(0.55+0.9*n2);
        shape*=smoothstep(-0.02,0.01,sAlong)*smoothstep(0.0,0.03,sHead-sAlong+0.03);
        float heat=lifeHot*(0.6+0.6*n2)*smoothstep(0.0,0.8,core);
        float fireI=shape*lifeHot*1.6;
        vec3 fc=fireRamp(heat*1.15)*fireI*1.8;
        col+=fc;
        alpha+=clamp(fireI,0.,1.);
        float sw=width*1.6+age*0.05;
        float sd=abs(perp-wob*1.4)/sw;
        float smk=exp(-sd*sd*1.5)*smoothstep(0.35,0.8,fbm(vec2(sAlong*7.0,perp*10.0-t*0.7)+n1))*1.4;
        float smkLife=smoothstep(0.0,0.08,age)*exp(-age*3.2)*smoothstep(0.8,0.6,t);
        smk*=smkLife*smoothstep(-0.02,0.02,sAlong);
        smokeCol+=vec3(0.22,0.16,0.13)*smk; smokeA+=smk*0.75;
    }
    if(flying>0.5){
        vec2 hp=p-head;
        float along=dot(hp,dir), across=dot(hp,nrm);
        vec2 e=vec2(along>0.?along*1.6:along*0.35,across);
        float r=length(e);
        float ang=atan(across,along);
        float flick=fbm(vec2(ang*3.0,r*40.0-t*30.0));
        float glow=0.0026/(r*r+0.0009)*(0.7+0.6*flick)*exp(-r*r*350.0);
        float coreR=length(hp);
        float core=smoothstep(0.022,0.008,coreR);
        float grow=0.7+0.5*smoothstep(0.0,T_IMPACT,t);
        col+=fireRamp(0.65+0.35*core)*glow*grow*fadeIn;
        col+=vec3(1.0,0.98,0.95)*core*3.0*fadeIn;
        float rock=smoothstep(0.012,0.009,coreR+(noise(hp*120.0)-0.5)*0.004);
        col=mix(col,col*vec3(1.0,0.85,0.7),rock*0.3);
        alpha+=clamp(glow*0.6+core,0.,1.)*fadeIn;
        float halo=exp(-coreR*coreR*220.0)*0.4*fadeIn*grow;
        col+=vec3(1.0,0.5,0.15)*halo; alpha+=halo*0.6;
    }
    for(int i=0;i<40;i++){
        float fi=float(i);
        float te=hash11(fi)*T_IMPACT;
        float age=t-te;
        if(age<0.0||age>0.3) continue;
        float u=te/T_IMPACT;
        vec2 ep=P0+dir*pathLen*(0.75*u+0.25*u*u);
        vec2 rv=hash21(fi+7.0)-0.5;
        vec2 vel=dir*speed*(0.15+0.25*hash11(fi+3.))+nrm*rv.x*0.9;
        vec2 pos=ep+vel*age*exp(-age*4.0)+vec2(0,-0.25)*age*age;
        float life=1.0-age/0.3;
        float sz=0.0025+0.002*hash11(fi+11.);
        float dd=length(p-pos);
        float g=sz*sz/(dd*dd+sz*sz*0.4)*life*life;
        col+=fireRamp(life*0.9)*g*1.5; alpha+=g*0.8;
    }
    float ti=t-T_IMPACT;
    if(ti>0.0){
        vec2 ip=p-P1;
        float r=length(ip);
        float flash=exp(-ti*22.0);
        float fl=(0.012/(r*r*3.0+0.004))*flash*0.35*exp(-r*r*40.0);
        col+=vec3(1.0,0.9,0.75)*fl; alpha+=fl;
        float fbR=0.04+0.15*(1.0-exp(-ti*14.0));
        float nb=fbm(vec2(atan(ip.y,ip.x)*2.5,r*18.0-ti*6.0)+3.0);
        float ball=smoothstep(fbR*(0.8+0.5*nb),0.0,r);
        float bl=exp(-ti*6.0);
        col+=fireRamp(ball*bl*1.4)*ball*bl*2.2; alpha+=ball*bl*1.2;
        vec2 sp=ip*vec2(1.0,2.6);
        float rr=0.25*(1.0-exp(-ti*9.0));
        float ring=exp(-pow((length(sp)-rr)/(0.008+ti*0.03),2.0))*exp(-ti*9.0);
        ring*=0.6+0.8*noise(vec2(atan(sp.y,sp.x)*8.0,ti*5.0));
        col+=vec3(1.0,0.7,0.4)*ring*1.4; alpha+=ring*0.8;
        float sR=0.04+0.16*(1.0-exp(-ti*8.0));
        vec2 sq=ip-vec2(0,ti*0.12);
        float sn=fbm(sq*14.0+vec2(0,-ti*3.0));
        float sm=smoothstep(sR,sR*0.2,length(sq*vec2(0.9,1.2))+(sn-0.5)*0.08);
        sm*=smoothstep(0.0,0.05,ti)*smoothstep(0.36,0.12,ti)*0.75*sn*1.6;
        smokeCol+=vec3(0.2,0.15,0.12)*sm; smokeA+=sm;
        for(int i=0;i<70;i++){
            float fi=float(i)+100.0;
            vec2 h=hash21(fi);
            float a=mix(0.15,3.0,h.x);
            float spd=mix(0.35,1.1,pow(h.y,1.5));
            vec2 v=vec2(cos(a),sin(a))*spd*vec2(1.0,0.85);
            float lt=0.18+0.17*hash11(fi+5.);
            if(ti>lt) continue;
            float drag=1.0-exp(-ti*5.0);
            vec2 pos=P1+v*drag/5.0+vec2(0,-0.9)*ti*ti;
            vec2 prev=P1+v*(1.0-exp(-(ti-0.02)*5.0))/5.0+vec2(0,-0.9)*(ti-0.02)*(ti-0.02);
            if(ti<0.02) prev=P1;
            vec2 pa=p-prev, ba=pos-prev;
            float hh=clamp(dot(pa,ba)/max(dot(ba,ba),1e-6),0.,1.);
            float dd=length(pa-ba*hh);
            float life=1.0-ti/lt;
            float sz=0.0026;
            float g=sz*sz/(dd*dd+sz*sz*0.3)*life*(0.4+0.6*hh);
            col+=fireRamp(life*1.05)*g*1.6; alpha+=g*0.7;
        }
        float cr=exp(-dot(ip*vec2(1.0,2.4),ip*vec2(1.0,2.4))*500.0)*exp(-ti*6.0)*smoothstep(0.0,0.02,ti);
        col+=vec3(1.0,0.35,0.05)*cr*1.2; alpha+=cr*0.8;
    }
    smokeA=clamp(smokeA,0.,0.85);
    alpha=clamp(alpha,0.,1.);
    vec3 em=1.0-exp(-col*1.3);
    float outA=clamp(alpha+smokeA*(1.0-alpha),0.,1.);
    vec3 outC=em+smokeCol*(1.0-alpha);
    float endF=smoothstep(0.8,0.7,t);
    outA*=endF; outC*=endF;
    fragColor=vec4(outC,outA);
}
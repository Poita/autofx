#define TAU 6.28318530718
#define DUR 1.5

float hash11(float p){ p = fract(p*0.1031); p *= p+33.33; p *= p+p; return fract(p); }
vec2 hash21(float p){ vec3 p3 = fract(vec3(p)*vec3(.1031,.1030,.0973)); p3 += dot(p3,p3.yzx+33.33); return fract((p3.xx+p3.yz)*p3.zy); }

vec3 palette(float h){
    vec3 a = vec3(1.0,0.78,0.35);
    vec3 b = vec3(1.0,0.45,0.8);
    vec3 c = vec3(0.6,0.5,1.0);
    vec3 d = vec3(0.45,0.9,1.0);
    if(h<0.33) return mix(a,b,h/0.33);
    if(h<0.66) return mix(b,c,(h-0.33)/0.33);
    return mix(c,d,(h-0.66)/0.34);
}

float flare(vec2 d, float L, float rot){
    float c = cos(rot), s = sin(rot);
    d = mat2(c,-s,s,c)*d;
    float w = 0.0045;
    float r = length(d);
    float tx = w*(1.0 - 0.8*clamp(abs(d.x)/L,0.0,1.0));
    float ty = w*(1.0 - 0.8*clamp(abs(d.y)/L,0.0,1.0));
    float rayX = exp(-(d.y*d.y)/(tx*tx)) * pow(max(1.0-abs(d.x)/L,0.0),2.0);
    float rayY = exp(-(d.x*d.x)/(ty*ty)) * pow(max(1.0-abs(d.y)/L,0.0),2.0);
    vec2 e = mat2(0.7071,-0.7071,0.7071,0.7071)*d;
    float Ld = L*0.4;
    float rayD = exp(-(e.y*e.y)/(w*w*0.5)) * pow(max(1.0-abs(e.x)/Ld,0.0),2.0)
               + exp(-(e.x*e.x)/(w*w*0.5)) * pow(max(1.0-abs(e.y)/Ld,0.0),2.0);
    float glow = exp(-r*r/(L*L*0.02))*1.0 + exp(-r*r/(L*L*0.12))*0.35;
    return glow + (rayX + rayY)*1.1 + rayD*0.5;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float t = fract(iTime/DUR);
    float seed = iSeed*17.13;
    vec3 col = vec3(0.0);

    const int N = 34;
    for(int i=0;i<N;i++){
        float fi = float(i) + seed;
        vec2 h = hash21(fi*1.37+3.1);
        float h3 = hash11(fi*7.77+1.3);
        float h4 = hash11(fi*3.11+9.7);
        float ang = h.x*TAU;
        float rad = 0.34*pow(h.y,0.6);
        ang += 0.05*sin(TAU*t + h4*TAU)/(rad+0.15);
        vec2 pos = vec2(cos(ang),sin(ang))*rad;
        pos.y += 0.01*sin(TAU*(t*2.0) + h3*TAU);

        float freq = (h3>0.55)?2.0:1.0;
        float ph = sin(TAU*(t*freq + h4));
        float tw = pow(max(ph,0.0), 4.0);

        float hero = pow(hash11(fi*9.1),3.0);
        float L = mix(0.035,0.12,hero) * (0.25+0.75*tw);
        float bright = mix(0.6,1.0,hash11(fi*5.3));
        float rot = (hash11(fi*2.2)-0.5)*0.3 + 0.35*sin(TAU*t*freq + h4*TAU);

        vec2 d = p - pos;
        float f = flare(d, L, rot) * (0.06 + tw) * bright;
        vec3 c = palette(fract(h3*0.9 + hash11(fi*4.4)*0.3));
        float core = exp(-dot(d,d)/(0.0035*0.0035 + L*L*0.004)) * tw * 2.0;
        col += c*f*1.4 + mix(c,vec3(1.0),0.6)*core;
    }

    const int M = 110;
    for(int i=0;i<M;i++){
        float fi = float(i) + seed + 100.0;
        vec2 h = hash21(fi*2.17+0.7);
        float ang = h.x*TAU + 0.08*sin(TAU*t + fi);
        float rad = 0.38*sqrt(h.y);
        vec2 pos = vec2(cos(ang),sin(ang))*rad;
        pos.y += 0.015*sin(TAU*t + h.x*13.0);
        float ph = hash11(fi*1.9);
        float tw = pow(0.5+0.5*sin(TAU*(t*(1.0+floor(ph*3.0)) + ph*5.0)), 6.0);
        vec2 d = p-pos;
        float dd = dot(d,d);
        vec3 c = palette(hash11(fi*6.6));
        float cross = exp(-abs(d.x)*900.0)*exp(-abs(d.y)*120.0) + exp(-abs(d.y)*900.0)*exp(-abs(d.x)*120.0);
        col += c * (exp(-dd*40000.0)*1.6 + exp(-dd*4000.0)*0.25 + cross*0.6) * tw;
    }

    col = 1.0 - exp(-col*1.3);
    float a = clamp(max(col.r,max(col.g,col.b)),0.0,1.0);
    vec3 outc = a>0.0001 ? col/a : vec3(0.0);
    fragColor = vec4(outc, a);
}

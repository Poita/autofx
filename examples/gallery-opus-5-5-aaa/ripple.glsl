#define PI 3.14159265
#define N 4

vec2 field(float r, float th, float t){
    vec2 acc = vec2(0.0);
    for(int i=0;i<N;i++){
        float fi = float(i);
        float a = fract(t/2.0 + fi/float(N));
        float wob = (sin(3.0*th + fi*2.3)*0.6 + sin(5.0*th - fi*1.7)*0.4) * 0.006 * a;
        float R = 0.03 + 0.37*a + wob;
        float w = 0.012 + 0.03*a;
        float k = 110.0 - 40.0*a;
        float amp = smoothstep(0.0, 0.10, a) * pow(1.0 - a, 1.4);
        float x = r - R;
        float g = exp(-(x*x)/(w*w));
        float c = cos(x*k), s = sin(x*k);
        acc += amp * g * vec2(c, -2.0*x/(w*w) * c - k*s);
    }
    return acc;
}

void mainImage(out vec4 fragColor, in vec2 fragCoord){
    vec2 p = (fragCoord - 0.5*iResolution.xy)/iResolution.y;
    float t = mod(iTime, 2.0);
    vec4 col = vec4(0.0);
    for(int sx=0;sx<4;sx++) for(int sy=0;sy<4;sy++){
        vec2 q = p + (vec2(float(sx),float(sy))-1.5)/(4.0*iResolution.y);
        float r = length(q);
        float th = atan(q.y,q.x);
        vec2 dirv = r>1e-5 ? q/r : vec2(0.0);
        vec2 f = field(r, th, t);
        float h = f.x, dh = f.y;
        vec3 n = normalize(vec3(-dh*dirv*0.035, 1.0));
        vec3 V = vec3(0,0,1);
        vec3 L = normalize(vec3(-0.55, 0.65, 0.55));
        vec3 L2 = normalize(vec3(0.6, -0.5, 0.6));
        float diff = clamp(dot(n,L),0.0,1.0);
        float spec = pow(clamp(dot(n,normalize(L+V)),0.0,1.0), 200.0);
        float spec2 = pow(clamp(dot(n,normalize(L2+V)),0.0,1.0), 80.0);
        float fres = pow(1.0 - n.z, 2.0);
        float slope = length(dh*0.035);

        vec3 deep = vec3(0.01, 0.12, 0.24);
        vec3 mid  = vec3(0.07, 0.42, 0.62);
        vec3 crest = vec3(0.55, 0.92, 1.0);
        float hh = clamp(0.5 + h*2.5, 0.0, 1.0);
        vec3 c = mix(deep, mid, smoothstep(0.0,0.6,hh));
        c = mix(c, crest, smoothstep(0.6,1.0,hh));
        c *= 0.45 + 0.75*diff;
        c += fres * vec3(0.5, 0.8, 1.0) * 2.0;
        c += vec3(1.0) * spec * 3.0 + vec3(0.6,0.85,1.0)*spec2*0.9;

        float a = clamp(abs(h)*3.0 + slope*1.6, 0.0, 1.0);
        a = smoothstep(0.03, 0.85, a);
        a = max(a, clamp(spec*3.0,0.0,1.0));
        col += vec4(c*a, a);
    }
    col /= 16.0;
    vec3 rgb = col.a > 1e-4 ? col.rgb/col.a : vec3(0.0);
    fragColor = vec4(rgb, col.a);
}